// Allows a watchdog reset to reset the internal state of powman in addition to the power-on state
// machine (PSM). Note that powman ignores watchdog resets that do not select at least the CLOCKS
// stage or earlier stages in the PSM. If using these bits, it's recommended to set PSM_WDSEL to
// all-ones in addition to the desired bits in this register. Failing to select CLOCKS or earlier
// will result in the POWMAN_WDSEL register having no effect.
const WDSEL_OFFSET: u32 = 0x00000030
const WDSEL_RESET_PSM_MASK: u32 = 0x00001000
const WDSEL_RESET_PSM_SHIFT: u32 = 12
const WDSEL_RESET_SWCORE_MASK: u32 = 0x00000100
const WDSEL_RESET_SWCORE_SHIFT: u32 = 8
const WDSEL_RESET_POWMAN_MASK: u32 = 0x00000010
const WDSEL_RESET_POWMAN_SHIFT: u32 = 4
const WDSEL_RESET_POWMAN_ASYNC_MASK: u32 = 0x00000001
const WDSEL_RESET_POWMAN_ASYNC_SHIFT: u32 = 0

