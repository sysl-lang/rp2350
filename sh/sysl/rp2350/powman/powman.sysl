const PWRUP3_OFFSET: u32 = 0x00000098
const PWRUP3_RAW_STATUS_MASK: u32 = 0x00000400
const PWRUP3_RAW_STATUS_SHIFT: u32 = 10
const PWRUP3_STATUS_MASK: u32 = 0x00000200
const PWRUP3_STATUS_SHIFT: u32 = 9
const PWRUP3_MODE_MASK: u32 = 0x00000100
const PWRUP3_MODE_SHIFT: u32 = 8
const PWRUP3_MODE_LEVEL: u32 = 0
const PWRUP3_MODE_EDGE: u32 = 1
