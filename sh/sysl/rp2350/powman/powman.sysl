// 4 GPIO powerup events can be configured to wake the chip up from a low power state. The pwrups
// are level/edge sensitive and can be set to trigger on a high/rising or low/falling event The
// number of gpios available depends on the package option. An invalid selection will be ignored
// source = 0 selects gpio0 . . source = 47 selects gpio47 source = 48 selects qspi_ss source = 49
// selects qspi_sd0 source = 50 selects qspi_sd1 source = 51 selects qspi_sd2 source = 52 selects
// qspi_sd3 source = 53 selects qspi_sclk level = 0 triggers the pwrup when the source is low level
// = 1 triggers the pwrup when the source is high
const PWRUP0_OFFSET: u32 = 0x0000008c
const PWRUP0_RAW_STATUS_MASK: u32 = 0x00000400
const PWRUP0_RAW_STATUS_SHIFT: u32 = 10
const PWRUP0_STATUS_MASK: u32 = 0x00000200
const PWRUP0_STATUS_SHIFT: u32 = 9
const PWRUP0_MODE_MASK: u32 = 0x00000100
const PWRUP0_MODE_SHIFT: u32 = 8
const PWRUP0_MODE_LEVEL: u32 = 0
const PWRUP0_MODE_EDGE: u32 = 1
const PWRUP0_DIRECTION_MASK: u32 = 0x00000080
const PWRUP0_DIRECTION_SHIFT: u32 = 7
const PWRUP0_DIRECTION_LOW_FALLING: u32 = 0
const PWRUP0_DIRECTION_HIGH_RISING: u32 = 1
const PWRUP0_ENABLE_MASK: u32 = 0x00000040
const PWRUP0_ENABLE_SHIFT: u32 = 6
const PWRUP0_SOURCE_MASK: u32 = 0x0000003f
const PWRUP0_SOURCE_SHIFT: u32 = 0

