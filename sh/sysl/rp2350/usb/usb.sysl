const MAIN_CTRL_CONTROLLER_EN_SHIFT: u32 = 0

// Set the SOF (Start of Frame) frame number in the host controller. The SOF packet is sent every
// 1ms and the host will increment the frame number by 1 each time.
const SOF_WR_OFFSET: u32 = 0x00000044
const SOF_WR_COUNT_MASK: u32 = 0x000007ff
const SOF_WR_COUNT_SHIFT: u32 = 0

// Read the last SOF (Start of Frame) frame number seen. In device mode the last SOF received from
// the host. In host mode the last SOF sent by the host.
const SOF_RD_OFFSET: u32 = 0x00000048
const SOF_RD_COUNT_MASK: u32 = 0x000007ff
const SOF_RD_COUNT_SHIFT: u32 = 0

