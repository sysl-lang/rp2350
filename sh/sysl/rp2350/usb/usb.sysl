const DEV_SM_WATCHDOG_ENABLE_SHIFT: u32 = 18
const DEV_SM_WATCHDOG_LIMIT_MASK: u32 = 0x0003ffff
const DEV_SM_WATCHDOG_LIMIT_SHIFT: u32 = 0
