const BIST_CNT_SHIFT: u32 = 0

// Word 0 (bits 31..0) of the key. Write only, read returns 0x0
const CRT_KEY_W0_OFFSET: u32 = 0x00000138
const CRT_KEY_W0_CRT_KEY_W0_MASK: u32 = 0xffffffff
const CRT_KEY_W0_CRT_KEY_W0_SHIFT: u32 = 0

