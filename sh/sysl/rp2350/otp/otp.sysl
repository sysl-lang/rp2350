// SNPS OTP control IF (SBPI and RPi wrapper control)

module sh.sysl.rp2350.otp

// The peripheral's base address. Every offset below is from here.
const BASE: u32 = 0x40120000

// Software lock register for page 0. Locks are initialised from the OTP lock pages at reset. This
// register can be written to further advance the lock state of each page (until next reset), and
// read to check the current lock state of a page.
