const CRT_KEY_W1_OFFSET: u32 = 0x0000013c
const CRT_KEY_W1_CRT_KEY_W1_MASK: u32 = 0xffffffff
const CRT_KEY_W1_CRT_KEY_W1_SHIFT: u32 = 0

// Word 2 (bits 95..64) of the key. Write only, read returns 0x0
const CRT_KEY_W2_OFFSET: u32 = 0x00000140
const CRT_KEY_W2_CRT_KEY_W2_MASK: u32 = 0xffffffff
const CRT_KEY_W2_CRT_KEY_W2_SHIFT: u32 = 0

// Word 3 (bits 127..96) of the key. Write only, read returns 0x0
const CRT_KEY_W3_OFFSET: u32 = 0x00000144
const CRT_KEY_W3_CRT_KEY_W3_MASK: u32 = 0xffffffff
const CRT_KEY_W3_CRT_KEY_W3_SHIFT: u32 = 0

// Quickly check values of critical flags read during boot up
const CRITICAL_OFFSET: u32 = 0x00000148
const CRITICAL_RISCV_DISABLE_MASK: u32 = 0x00020000
const CRITICAL_RISCV_DISABLE_SHIFT: u32 = 17
const CRITICAL_ARM_DISABLE_MASK: u32 = 0x00010000
const CRITICAL_ARM_DISABLE_SHIFT: u32 = 16
const CRITICAL_GLITCH_DETECTOR_SENS_MASK: u32 = 0x00000060
const CRITICAL_GLITCH_DETECTOR_SENS_SHIFT: u32 = 5
