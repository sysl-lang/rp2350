const SBPI_WDATA_3_SBPI_WDATA_3_MASK: u32 = 0xffffffff
const SBPI_WDATA_3_SBPI_WDATA_3_SHIFT: u32 = 0

// Read payload bytes 3..0. Once read, the data in the register will automatically clear to 0.
const SBPI_RDATA_0_OFFSET: u32 = 0x00000114
const SBPI_RDATA_0_SBPI_RDATA_0_MASK: u32 = 0xffffffff
const SBPI_RDATA_0_SBPI_RDATA_0_SHIFT: u32 = 0

// Read payload bytes 7..4. Once read, the data in the register will automatically clear to 0.
const SBPI_RDATA_1_OFFSET: u32 = 0x00000118
const SBPI_RDATA_1_SBPI_RDATA_1_MASK: u32 = 0xffffffff
const SBPI_RDATA_1_SBPI_RDATA_1_SHIFT: u32 = 0

// Read payload bytes 11..8. Once read, the data in the register will automatically clear to 0.
const SBPI_RDATA_2_OFFSET: u32 = 0x0000011c
const SBPI_RDATA_2_SBPI_RDATA_2_MASK: u32 = 0xffffffff
const SBPI_RDATA_2_SBPI_RDATA_2_SHIFT: u32 = 0

// Read payload bytes 15..12. Once read, the data in the register will automatically clear to 0.
const SBPI_RDATA_3_OFFSET: u32 = 0x00000120
const SBPI_RDATA_3_SBPI_RDATA_3_MASK: u32 = 0xffffffff
const SBPI_RDATA_3_SBPI_RDATA_3_SHIFT: u32 = 0

const SBPI_STATUS_OFFSET: u32 = 0x00000124
