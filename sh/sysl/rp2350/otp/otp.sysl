const SW_LOCK62_OFFSET: u32 = 0x000000f8
const SW_LOCK62_NSEC_MASK: u32 = 0x0000000c
const SW_LOCK62_NSEC_SHIFT: u32 = 2
const SW_LOCK62_NSEC_READ_WRITE: u32 = 0
const SW_LOCK62_NSEC_READ_ONLY: u32 = 1
const SW_LOCK62_NSEC_INACCESSIBLE: u32 = 3
const SW_LOCK62_SEC_MASK: u32 = 0x00000003
const SW_LOCK62_SEC_SHIFT: u32 = 0
const SW_LOCK62_SEC_READ_WRITE: u32 = 0
const SW_LOCK62_SEC_READ_ONLY: u32 = 1
const SW_LOCK62_SEC_INACCESSIBLE: u32 = 3

// Software lock register for page 63. Locks are initialised from the OTP lock pages at reset. This
// register can be written to further advance the lock state of each page (until next reset), and
// read to check the current lock state of a page.
const SW_LOCK63_OFFSET: u32 = 0x000000fc
const SW_LOCK63_NSEC_MASK: u32 = 0x0000000c
const SW_LOCK63_NSEC_SHIFT: u32 = 2
const SW_LOCK63_NSEC_READ_WRITE: u32 = 0
const SW_LOCK63_NSEC_READ_ONLY: u32 = 1
const SW_LOCK63_NSEC_INACCESSIBLE: u32 = 3
const SW_LOCK63_SEC_MASK: u32 = 0x00000003
const SW_LOCK63_SEC_SHIFT: u32 = 0
const SW_LOCK63_SEC_READ_WRITE: u32 = 0
const SW_LOCK63_SEC_READ_ONLY: u32 = 1
const SW_LOCK63_SEC_INACCESSIBLE: u32 = 3

