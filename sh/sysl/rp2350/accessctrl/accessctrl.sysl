// Hardware access control registers

module sh.sysl.rp2350.accessctrl

// The peripheral's base address. Every offset below is from here.
const BASE: u32 = 0x40060000

// Once a LOCK bit is written to 1, ACCESSCTRL silently ignores writes from that master. LOCK is
// writable only by a Secure, Privileged processor or debugger. LOCK bits are only writable when
// their value is zero. Once set, they can never be cleared, except by a full reset of ACCESSCTRL
// Setting the LOCK bit does not affect whether an access raises a bus error. Unprivileged writes,
// or writes from the DMA, will continue to raise bus errors. All other accesses will continue not
// to.
const LOCK_OFFSET: u32 = 0x00000000
const LOCK_DEBUG_MASK: u32 = 0x00000008
const LOCK_DEBUG_SHIFT: u32 = 3
const LOCK_DMA_MASK: u32 = 0x00000004
const LOCK_DMA_SHIFT: u32 = 2
const LOCK_CORE1_MASK: u32 = 0x00000002
const LOCK_CORE1_SHIFT: u32 = 1
const LOCK_CORE0_MASK: u32 = 0x00000001
const LOCK_CORE0_SHIFT: u32 = 0

// Force core 1's bus accesses to always be Non-secure, no matter the core's internal state. Useful
// for schemes where one core is designated as the Non-secure core, since some peripherals may
// filter individual registers internally based on security state but not on master ID.
const FORCE_CORE_NS_OFFSET: u32 = 0x00000004
const FORCE_CORE_NS_CORE1_MASK: u32 = 0x00000002
const FORCE_CORE_NS_CORE1_SHIFT: u32 = 1

// Write 1 to reset all ACCESSCTRL configuration, except for the LOCK and FORCE_CORE_NS registers.
// This bit is used in the RP2350 bootrom to quickly restore ACCESSCTRL to a known state during the
// boot path. Note that, like all registers in ACCESSCTRL, this register is not writable when the
// writer's corresponding LOCK bit is set, therefore a master which has been locked out of
// ACCESSCTRL can not use the CFGRESET register to disturb its contents.
const CFGRESET_OFFSET: u32 = 0x00000008
const CFGRESET_CFGRESET_MASK: u32 = 0x00000001
const CFGRESET_CFGRESET_SHIFT: u32 = 0

// Control whether GPIO0...31 are accessible to Non-secure code. Writable only by a Secure,
// Privileged processor or debugger. 0 -> Secure access only 1 -> Secure + Non-secure access
const GPIO_NSMASK0_OFFSET: u32 = 0x0000000c
const GPIO_NSMASK0_GPIO_NSMASK0_MASK: u32 = 0xffffffff
const GPIO_NSMASK0_GPIO_NSMASK0_SHIFT: u32 = 0

// Control whether GPIO32..47 are accessible to Non-secure code, and whether QSPI and USB bitbang
// are accessible through the Non-secure SIO. Writable only by a Secure, Privileged processor or
// debugger.
const GPIO_NSMASK1_OFFSET: u32 = 0x00000010
const GPIO_NSMASK1_QSPI_SD_MASK: u32 = 0xf0000000
const GPIO_NSMASK1_QSPI_SD_SHIFT: u32 = 28
const GPIO_NSMASK1_QSPI_CSN_MASK: u32 = 0x08000000
const GPIO_NSMASK1_QSPI_CSN_SHIFT: u32 = 27
const GPIO_NSMASK1_QSPI_SCK_MASK: u32 = 0x04000000
const GPIO_NSMASK1_QSPI_SCK_SHIFT: u32 = 26
const GPIO_NSMASK1_USB_DM_MASK: u32 = 0x02000000
const GPIO_NSMASK1_USB_DM_SHIFT: u32 = 25
const GPIO_NSMASK1_USB_DP_MASK: u32 = 0x01000000
const GPIO_NSMASK1_USB_DP_SHIFT: u32 = 24
const GPIO_NSMASK1_GPIO_MASK: u32 = 0x0000ffff
const GPIO_NSMASK1_GPIO_SHIFT: u32 = 0

// Control whether debugger, DMA, core 0 and core 1 can access ROM, and at what security/privilege
// levels they can do so. Defaults to fully open access. This register is writable only from a
// Secure, Privileged processor or debugger, with the exception of the NSU bit, which becomes
// Non-secure-Privileged-writable when the NSP bit is set.
const ROM_OFFSET: u32 = 0x00000014
const ROM_DBG_MASK: u32 = 0x00000080
const ROM_DBG_SHIFT: u32 = 7
const ROM_DMA_MASK: u32 = 0x00000040
const ROM_DMA_SHIFT: u32 = 6
const ROM_CORE1_MASK: u32 = 0x00000020
const ROM_CORE1_SHIFT: u32 = 5
const ROM_CORE0_MASK: u32 = 0x00000010
const ROM_CORE0_SHIFT: u32 = 4
const ROM_SP_MASK: u32 = 0x00000008
const ROM_SP_SHIFT: u32 = 3
const ROM_SU_MASK: u32 = 0x00000004
const ROM_SU_SHIFT: u32 = 2
const ROM_NSP_MASK: u32 = 0x00000002
const ROM_NSP_SHIFT: u32 = 1
const ROM_NSU_MASK: u32 = 0x00000001
const ROM_NSU_SHIFT: u32 = 0

