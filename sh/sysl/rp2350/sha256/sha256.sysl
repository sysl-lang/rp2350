// SHA-256 hash function implementation

module sh.sysl.rp2350.sha256

// The peripheral's base address. Every offset below is from here.
const BASE: u32 = 0x400f8000

// Control and status register
const CSR_OFFSET: u32 = 0x00000000
const CSR_BSWAP_MASK: u32 = 0x00001000
const CSR_BSWAP_SHIFT: u32 = 12
const CSR_DMA_SIZE_MASK: u32 = 0x00000300
const CSR_DMA_SIZE_SHIFT: u32 = 8
const CSR_DMA_SIZE_8BIT: u32 = 0
const CSR_DMA_SIZE_16BIT: u32 = 1
const CSR_DMA_SIZE_32BIT: u32 = 2
const CSR_ERR_WDATA_NOT_RDY_MASK: u32 = 0x00000010
const CSR_ERR_WDATA_NOT_RDY_SHIFT: u32 = 4
const CSR_SUM_VLD_MASK: u32 = 0x00000004
const CSR_SUM_VLD_SHIFT: u32 = 2
const CSR_WDATA_RDY_MASK: u32 = 0x00000002
const CSR_WDATA_RDY_SHIFT: u32 = 1
const CSR_START_MASK: u32 = 0x00000001
const CSR_START_SHIFT: u32 = 0

// Write data register
const WDATA_OFFSET: u32 = 0x00000004
const WDATA_WDATA_MASK: u32 = 0xffffffff
const WDATA_WDATA_SHIFT: u32 = 0

// 256-bit checksum result. Contents are undefined when CSR_SUM_VLD is 0.
const SUM0_OFFSET: u32 = 0x00000008
const SUM0_SUM0_MASK: u32 = 0xffffffff
const SUM0_SUM0_SHIFT: u32 = 0

// 256-bit checksum result. Contents are undefined when CSR_SUM_VLD is 0.
const SUM1_OFFSET: u32 = 0x0000000c
const SUM1_SUM1_MASK: u32 = 0xffffffff
const SUM1_SUM1_SHIFT: u32 = 0

// 256-bit checksum result. Contents are undefined when CSR_SUM_VLD is 0.
const SUM2_OFFSET: u32 = 0x00000010
const SUM2_SUM2_MASK: u32 = 0xffffffff
const SUM2_SUM2_SHIFT: u32 = 0

// 256-bit checksum result. Contents are undefined when CSR_SUM_VLD is 0.
const SUM3_OFFSET: u32 = 0x00000014
const SUM3_SUM3_MASK: u32 = 0xffffffff
const SUM3_SUM3_SHIFT: u32 = 0

// 256-bit checksum result. Contents are undefined when CSR_SUM_VLD is 0.
const SUM4_OFFSET: u32 = 0x00000018
const SUM4_SUM4_MASK: u32 = 0xffffffff
const SUM4_SUM4_SHIFT: u32 = 0

// 256-bit checksum result. Contents are undefined when CSR_SUM_VLD is 0.
const SUM5_OFFSET: u32 = 0x0000001c
const SUM5_SUM5_MASK: u32 = 0xffffffff
const SUM5_SUM5_SHIFT: u32 = 0

// 256-bit checksum result. Contents are undefined when CSR_SUM_VLD is 0.
const SUM6_OFFSET: u32 = 0x00000020
const SUM6_SUM6_MASK: u32 = 0xffffffff
const SUM6_SUM6_SHIFT: u32 = 0

// 256-bit checksum result. Contents are undefined when CSR_SUM_VLD is 0.
const SUM7_OFFSET: u32 = 0x00000024
const SUM7_SUM7_MASK: u32 = 0xffffffff
const SUM7_SUM7_SHIFT: u32 = 0
