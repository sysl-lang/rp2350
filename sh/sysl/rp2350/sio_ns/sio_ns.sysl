const TMDS_CTRL_L2_NBITS_MASK: u32 = 0x001c0000
const TMDS_CTRL_L2_NBITS_SHIFT: u32 = 18
const TMDS_CTRL_L1_NBITS_MASK: u32 = 0x00038000
const TMDS_CTRL_L1_NBITS_SHIFT: u32 = 15
const TMDS_CTRL_L0_NBITS_MASK: u32 = 0x00007000
const TMDS_CTRL_L0_NBITS_SHIFT: u32 = 12
const TMDS_CTRL_L2_ROT_MASK: u32 = 0x00000f00
const TMDS_CTRL_L2_ROT_SHIFT: u32 = 8
const TMDS_CTRL_L1_ROT_MASK: u32 = 0x000000f0
const TMDS_CTRL_L1_ROT_SHIFT: u32 = 4
const TMDS_CTRL_L0_ROT_MASK: u32 = 0x0000000f
const TMDS_CTRL_L0_ROT_SHIFT: u32 = 0

// Write-only access to the TMDS colour data register.
const TMDS_WDATA_OFFSET: u32 = 0x000001c4
const TMDS_WDATA_TMDS_WDATA_MASK: u32 = 0xffffffff
const TMDS_WDATA_TMDS_WDATA_SHIFT: u32 = 0

// Get the encoding of one pixel's worth of colour data, packed into a 32-bit value (3x10-bit
// symbols). The PEEK alias does not shift the colour register when read, but still advances the
// running DC balance state of each encoder. This is useful for pixel doubling.
const TMDS_PEEK_SINGLE_OFFSET: u32 = 0x000001c8
const TMDS_PEEK_SINGLE_TMDS_PEEK_SINGLE_MASK: u32 = 0xffffffff
const TMDS_PEEK_SINGLE_TMDS_PEEK_SINGLE_SHIFT: u32 = 0

// Get the encoding of one pixel's worth of colour data, packed into a 32-bit value. The packing is
// 5 chunks of 3 lanes times 2 bits (30 bits total). Each chunk contains two bits of a TMDS symbol
// per lane. This format is intended for shifting out with the HSTX peripheral on RP2350. The POP
// alias shifts the colour register when read, as well as advancing the running DC balance state of
// each encoder.
const TMDS_POP_SINGLE_OFFSET: u32 = 0x000001cc
const TMDS_POP_SINGLE_TMDS_POP_SINGLE_MASK: u32 = 0xffffffff
const TMDS_POP_SINGLE_TMDS_POP_SINGLE_SHIFT: u32 = 0

// Get lane 0 of the encoding of two pixels' worth of colour data. Two 10-bit TMDS symbols are
// packed at the bottom of a 32-bit word. The PEEK alias does not shift the colour register when
// read, but still advances the lane 0 DC balance state. This is useful if all 3 lanes' worth of
// encode are to be read at once, rather than processing the entire scanline for one lane before
// moving to the next lane.
const TMDS_PEEK_DOUBLE_L0_OFFSET: u32 = 0x000001d0
const TMDS_PEEK_DOUBLE_L0_TMDS_PEEK_DOUBLE_L0_MASK: u32 = 0xffffffff
const TMDS_PEEK_DOUBLE_L0_TMDS_PEEK_DOUBLE_L0_SHIFT: u32 = 0

// Get lane 0 of the encoding of two pixels' worth of colour data. Two 10-bit TMDS symbols are
// packed at the bottom of a 32-bit word. The POP alias shifts the colour register when read,
// according to the values of PIX_SHIFT and PIX2_NOSHIFT.
const TMDS_POP_DOUBLE_L0_OFFSET: u32 = 0x000001d4
const TMDS_POP_DOUBLE_L0_TMDS_POP_DOUBLE_L0_MASK: u32 = 0xffffffff
const TMDS_POP_DOUBLE_L0_TMDS_POP_DOUBLE_L0_SHIFT: u32 = 0

// Get lane 1 of the encoding of two pixels' worth of colour data. Two 10-bit TMDS symbols are
// packed at the bottom of a 32-bit word. The PEEK alias does not shift the colour register when
// read, but still advances the lane 1 DC balance state. This is useful if all 3 lanes' worth of
// encode are to be read at once, rather than processing the entire scanline for one lane before
// moving to the next lane.
const TMDS_PEEK_DOUBLE_L1_OFFSET: u32 = 0x000001d8
const TMDS_PEEK_DOUBLE_L1_TMDS_PEEK_DOUBLE_L1_MASK: u32 = 0xffffffff
const TMDS_PEEK_DOUBLE_L1_TMDS_PEEK_DOUBLE_L1_SHIFT: u32 = 0

// Get lane 1 of the encoding of two pixels' worth of colour data. Two 10-bit TMDS symbols are
// packed at the bottom of a 32-bit word. The POP alias shifts the colour register when read,
// according to the values of PIX_SHIFT and PIX2_NOSHIFT.
const TMDS_POP_DOUBLE_L1_OFFSET: u32 = 0x000001dc
const TMDS_POP_DOUBLE_L1_TMDS_POP_DOUBLE_L1_MASK: u32 = 0xffffffff
const TMDS_POP_DOUBLE_L1_TMDS_POP_DOUBLE_L1_SHIFT: u32 = 0

// Get lane 2 of the encoding of two pixels' worth of colour data. Two 10-bit TMDS symbols are
// packed at the bottom of a 32-bit word. The PEEK alias does not shift the colour register when
// read, but still advances the lane 2 DC balance state. This is useful if all 3 lanes' worth of
// encode are to be read at once, rather than processing the entire scanline for one lane before
// moving to the next lane.
const TMDS_PEEK_DOUBLE_L2_OFFSET: u32 = 0x000001e0
const TMDS_PEEK_DOUBLE_L2_TMDS_PEEK_DOUBLE_L2_MASK: u32 = 0xffffffff
const TMDS_PEEK_DOUBLE_L2_TMDS_PEEK_DOUBLE_L2_SHIFT: u32 = 0

// Get lane 2 of the encoding of two pixels' worth of colour data. Two 10-bit TMDS symbols are
// packed at the bottom of a 32-bit word. The POP alias shifts the colour register when read,
// according to the values of PIX_SHIFT and PIX2_NOSHIFT.
const TMDS_POP_DOUBLE_L2_OFFSET: u32 = 0x000001e4
const TMDS_POP_DOUBLE_L2_TMDS_POP_DOUBLE_L2_MASK: u32 = 0xffffffff
const TMDS_POP_DOUBLE_L2_TMDS_POP_DOUBLE_L2_SHIFT: u32 = 0
