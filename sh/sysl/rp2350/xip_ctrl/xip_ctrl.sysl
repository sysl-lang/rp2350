// QSPI flash execute-in-place block

module sh.sysl.rp2350.xip_ctrl

// The peripheral's base address. Every offset below is from here.
const BASE: u32 = 0x400c8000

// Cache control register. Read-only from a Non-secure context.
const CTRL_OFFSET: u32 = 0x00000000
const CTRL_WRITABLE_M1_MASK: u32 = 0x00000800
const CTRL_WRITABLE_M1_SHIFT: u32 = 11
const CTRL_WRITABLE_M0_MASK: u32 = 0x00000400
const CTRL_WRITABLE_M0_SHIFT: u32 = 10
const CTRL_SPLIT_WAYS_MASK: u32 = 0x00000200
const CTRL_SPLIT_WAYS_SHIFT: u32 = 9
const CTRL_MAINT_NONSEC_MASK: u32 = 0x00000100
const CTRL_MAINT_NONSEC_SHIFT: u32 = 8
const CTRL_NO_UNTRANSLATED_NONSEC_MASK: u32 = 0x00000080
const CTRL_NO_UNTRANSLATED_NONSEC_SHIFT: u32 = 7
const CTRL_NO_UNTRANSLATED_SEC_MASK: u32 = 0x00000040
const CTRL_NO_UNTRANSLATED_SEC_SHIFT: u32 = 6
const CTRL_NO_UNCACHED_NONSEC_MASK: u32 = 0x00000020
const CTRL_NO_UNCACHED_NONSEC_SHIFT: u32 = 5
const CTRL_NO_UNCACHED_SEC_MASK: u32 = 0x00000010
const CTRL_NO_UNCACHED_SEC_SHIFT: u32 = 4
const CTRL_POWER_DOWN_MASK: u32 = 0x00000008
const CTRL_POWER_DOWN_SHIFT: u32 = 3
const CTRL_EN_NONSECURE_MASK: u32 = 0x00000002
const CTRL_EN_NONSECURE_SHIFT: u32 = 1
const CTRL_EN_SECURE_MASK: u32 = 0x00000001
const CTRL_EN_SECURE_SHIFT: u32 = 0

const STAT_OFFSET: u32 = 0x00000008
const STAT_FIFO_FULL_MASK: u32 = 0x00000004
const STAT_FIFO_FULL_SHIFT: u32 = 2
const STAT_FIFO_EMPTY_MASK: u32 = 0x00000002
const STAT_FIFO_EMPTY_SHIFT: u32 = 1

// Cache Hit counter
const CTR_HIT_OFFSET: u32 = 0x0000000c
const CTR_HIT_CTR_HIT_MASK: u32 = 0xffffffff
const CTR_HIT_CTR_HIT_SHIFT: u32 = 0

// Cache Access counter
const CTR_ACC_OFFSET: u32 = 0x00000010
const CTR_ACC_CTR_ACC_MASK: u32 = 0xffffffff
const CTR_ACC_CTR_ACC_SHIFT: u32 = 0

// FIFO stream address
const STREAM_ADDR_OFFSET: u32 = 0x00000014
const STREAM_ADDR_STREAM_ADDR_MASK: u32 = 0xfffffffc
const STREAM_ADDR_STREAM_ADDR_SHIFT: u32 = 2

// FIFO stream control
const STREAM_CTR_OFFSET: u32 = 0x00000018
const STREAM_CTR_STREAM_CTR_MASK: u32 = 0x003fffff
const STREAM_CTR_STREAM_CTR_SHIFT: u32 = 0

// FIFO stream data
const STREAM_FIFO_OFFSET: u32 = 0x0000001c
const STREAM_FIFO_STREAM_FIFO_MASK: u32 = 0xffffffff
const STREAM_FIFO_STREAM_FIFO_SHIFT: u32 = 0
