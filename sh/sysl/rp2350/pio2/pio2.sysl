module sh.sysl.rp2350.pio2

// The peripheral's base address. Every offset below is from here.
const BASE: u32 = 0x50400000

// PIO control register
const CTRL_OFFSET: u32 = 0x00000000
const CTRL_NEXTPREV_CLKDIV_RESTART_MASK: u32 = 0x04000000
const CTRL_NEXTPREV_CLKDIV_RESTART_SHIFT: u32 = 26
const CTRL_NEXTPREV_SM_DISABLE_MASK: u32 = 0x02000000
const CTRL_NEXTPREV_SM_DISABLE_SHIFT: u32 = 25
const CTRL_NEXTPREV_SM_ENABLE_MASK: u32 = 0x01000000
const CTRL_NEXTPREV_SM_ENABLE_SHIFT: u32 = 24
const CTRL_NEXT_PIO_MASK_MASK: u32 = 0x00f00000
const CTRL_NEXT_PIO_MASK_SHIFT: u32 = 20
const CTRL_PREV_PIO_MASK_MASK: u32 = 0x000f0000
const CTRL_PREV_PIO_MASK_SHIFT: u32 = 16
const CTRL_CLKDIV_RESTART_MASK: u32 = 0x00000f00
const CTRL_CLKDIV_RESTART_SHIFT: u32 = 8
const CTRL_SM_RESTART_MASK: u32 = 0x000000f0
const CTRL_SM_RESTART_SHIFT: u32 = 4
const CTRL_SM_ENABLE_MASK: u32 = 0x0000000f
const CTRL_SM_ENABLE_SHIFT: u32 = 0

// FIFO status register
const FSTAT_OFFSET: u32 = 0x00000004
const FSTAT_TXEMPTY_MASK: u32 = 0x0f000000
const FSTAT_TXEMPTY_SHIFT: u32 = 24
const FSTAT_TXFULL_MASK: u32 = 0x000f0000
const FSTAT_TXFULL_SHIFT: u32 = 16
const FSTAT_RXEMPTY_MASK: u32 = 0x00000f00
const FSTAT_RXEMPTY_SHIFT: u32 = 8
const FSTAT_RXFULL_MASK: u32 = 0x0000000f
const FSTAT_RXFULL_SHIFT: u32 = 0

// FIFO debug register
const FDEBUG_OFFSET: u32 = 0x00000008
const FDEBUG_TXSTALL_MASK: u32 = 0x0f000000
const FDEBUG_TXSTALL_SHIFT: u32 = 24
const FDEBUG_TXOVER_MASK: u32 = 0x000f0000
const FDEBUG_TXOVER_SHIFT: u32 = 16
const FDEBUG_RXUNDER_MASK: u32 = 0x00000f00
const FDEBUG_RXUNDER_SHIFT: u32 = 8
const FDEBUG_RXSTALL_MASK: u32 = 0x0000000f
const FDEBUG_RXSTALL_SHIFT: u32 = 0

// FIFO levels
const FLEVEL_OFFSET: u32 = 0x0000000c
const FLEVEL_RX3_MASK: u32 = 0xf0000000
const FLEVEL_RX3_SHIFT: u32 = 28
const FLEVEL_TX3_MASK: u32 = 0x0f000000
const FLEVEL_TX3_SHIFT: u32 = 24
const FLEVEL_RX2_MASK: u32 = 0x00f00000
const FLEVEL_RX2_SHIFT: u32 = 20
const FLEVEL_TX2_MASK: u32 = 0x000f0000
const FLEVEL_TX2_SHIFT: u32 = 16
const FLEVEL_RX1_MASK: u32 = 0x0000f000
const FLEVEL_RX1_SHIFT: u32 = 12
const FLEVEL_TX1_MASK: u32 = 0x00000f00
const FLEVEL_TX1_SHIFT: u32 = 8
const FLEVEL_RX0_MASK: u32 = 0x000000f0
const FLEVEL_RX0_SHIFT: u32 = 4
const FLEVEL_TX0_MASK: u32 = 0x0000000f
const FLEVEL_TX0_SHIFT: u32 = 0

// Direct write access to the TX FIFO for this state machine. Each write pushes one word to the
// FIFO. Attempting to write to a full FIFO has no effect on the FIFO state or contents, and sets
// the sticky FDEBUG_TXOVER error flag for this FIFO.
const TXF0_OFFSET: u32 = 0x00000010
const TXF0_TXF0_MASK: u32 = 0xffffffff
const TXF0_TXF0_SHIFT: u32 = 0

// Direct write access to the TX FIFO for this state machine. Each write pushes one word to the
// FIFO. Attempting to write to a full FIFO has no effect on the FIFO state or contents, and sets
// the sticky FDEBUG_TXOVER error flag for this FIFO.
const TXF1_OFFSET: u32 = 0x00000014
const TXF1_TXF1_MASK: u32 = 0xffffffff
const TXF1_TXF1_SHIFT: u32 = 0

// Direct write access to the TX FIFO for this state machine. Each write pushes one word to the
// FIFO. Attempting to write to a full FIFO has no effect on the FIFO state or contents, and sets
// the sticky FDEBUG_TXOVER error flag for this FIFO.
const TXF2_OFFSET: u32 = 0x00000018
const TXF2_TXF2_MASK: u32 = 0xffffffff
const TXF2_TXF2_SHIFT: u32 = 0

// Direct write access to the TX FIFO for this state machine. Each write pushes one word to the
// FIFO. Attempting to write to a full FIFO has no effect on the FIFO state or contents, and sets
// the sticky FDEBUG_TXOVER error flag for this FIFO.
const TXF3_OFFSET: u32 = 0x0000001c
const TXF3_TXF3_MASK: u32 = 0xffffffff
const TXF3_TXF3_SHIFT: u32 = 0

// Direct read access to the RX FIFO for this state machine. Each read pops one word from the FIFO.
// Attempting to read from an empty FIFO has no effect on the FIFO state, and sets the sticky
// FDEBUG_RXUNDER error flag for this FIFO. The data returned to the system on a read from an empty
// FIFO is undefined.
const RXF0_OFFSET: u32 = 0x00000020
const RXF0_RXF0_MASK: u32 = 0xffffffff
const RXF0_RXF0_SHIFT: u32 = 0

// Direct read access to the RX FIFO for this state machine. Each read pops one word from the FIFO.
// Attempting to read from an empty FIFO has no effect on the FIFO state, and sets the sticky
// FDEBUG_RXUNDER error flag for this FIFO. The data returned to the system on a read from an empty
// FIFO is undefined.
const RXF1_OFFSET: u32 = 0x00000024
const RXF1_RXF1_MASK: u32 = 0xffffffff
const RXF1_RXF1_SHIFT: u32 = 0

// Direct read access to the RX FIFO for this state machine. Each read pops one word from the FIFO.
// Attempting to read from an empty FIFO has no effect on the FIFO state, and sets the sticky
// FDEBUG_RXUNDER error flag for this FIFO. The data returned to the system on a read from an empty
// FIFO is undefined.
const RXF2_OFFSET: u32 = 0x00000028
const RXF2_RXF2_MASK: u32 = 0xffffffff
const RXF2_RXF2_SHIFT: u32 = 0

// Direct read access to the RX FIFO for this state machine. Each read pops one word from the FIFO.
// Attempting to read from an empty FIFO has no effect on the FIFO state, and sets the sticky
// FDEBUG_RXUNDER error flag for this FIFO. The data returned to the system on a read from an empty
// FIFO is undefined.
const RXF3_OFFSET: u32 = 0x0000002c
const RXF3_RXF3_MASK: u32 = 0xffffffff
const RXF3_RXF3_SHIFT: u32 = 0

// State machine IRQ flags register. Write 1 to clear. There are eight state machine IRQ flags,
// which can be set, cleared, and waited on by the state machines. There's no fixed association
// between flags and state machines -- any state machine can use any flag. Any of the eight flags
// can be used for timing synchronisation between state machines, using IRQ and WAIT instructions.
// Any combination of the eight flags can also routed out to either of the two system-level
// interrupt requests, alongside FIFO status interrupts -- see e.g. IRQ0_INTE.
const IRQ_OFFSET: u32 = 0x00000030
const IRQ_IRQ_MASK: u32 = 0x000000ff
const IRQ_IRQ_SHIFT: u32 = 0

// Writing a 1 to each of these bits will forcibly assert the corresponding IRQ. Note this is
// different to the INTF register: writing here affects PIO internal state. INTF just asserts the
// processor-facing IRQ signal for testing ISRs, and is not visible to the state machines.
const IRQ_FORCE_OFFSET: u32 = 0x00000034
const IRQ_FORCE_IRQ_FORCE_MASK: u32 = 0x000000ff
const IRQ_FORCE_IRQ_FORCE_SHIFT: u32 = 0

// There is a 2-flipflop synchronizer on each GPIO input, which protects PIO logic from
// metastabilities. This increases input delay, and for fast synchronous IO (e.g. SPI) these
// synchronizers may need to be bypassed. Each bit in this register corresponds to one GPIO. 0 ->
// input is synchronized (default) 1 -> synchronizer is bypassed If in doubt, leave this register
// as all zeroes.
const INPUT_SYNC_BYPASS_OFFSET: u32 = 0x00000038
const INPUT_SYNC_BYPASS_INPUT_SYNC_BYPASS_MASK: u32 = 0xffffffff
const INPUT_SYNC_BYPASS_INPUT_SYNC_BYPASS_SHIFT: u32 = 0

// Read to sample the pad output values PIO is currently driving to the GPIOs. On RP2040 there are
// 30 GPIOs, so the two most significant bits are hardwired to 0.
const DBG_PADOUT_OFFSET: u32 = 0x0000003c
const DBG_PADOUT_DBG_PADOUT_MASK: u32 = 0xffffffff
const DBG_PADOUT_DBG_PADOUT_SHIFT: u32 = 0

// Read to sample the pad output enables (direction) PIO is currently driving to the GPIOs. On
// RP2040 there are 30 GPIOs, so the two most significant bits are hardwired to 0.
const DBG_PADOE_OFFSET: u32 = 0x00000040
const DBG_PADOE_DBG_PADOE_MASK: u32 = 0xffffffff
const DBG_PADOE_DBG_PADOE_SHIFT: u32 = 0

// The PIO hardware has some free parameters that may vary between chip products. These should be
// provided in the chip datasheet, but are also exposed here.
const DBG_CFGINFO_OFFSET: u32 = 0x00000044
const DBG_CFGINFO_VERSION_MASK: u32 = 0xf0000000
const DBG_CFGINFO_VERSION_SHIFT: u32 = 28
const DBG_CFGINFO_VERSION_V0: u32 = 0
const DBG_CFGINFO_VERSION_V1: u32 = 1
const DBG_CFGINFO_IMEM_SIZE_MASK: u32 = 0x003f0000
const DBG_CFGINFO_IMEM_SIZE_SHIFT: u32 = 16
const DBG_CFGINFO_SM_COUNT_MASK: u32 = 0x00000f00
const DBG_CFGINFO_SM_COUNT_SHIFT: u32 = 8
const DBG_CFGINFO_FIFO_DEPTH_MASK: u32 = 0x0000003f
const DBG_CFGINFO_FIFO_DEPTH_SHIFT: u32 = 0

