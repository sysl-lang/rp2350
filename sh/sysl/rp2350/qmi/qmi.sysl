// Receive FIFO for direct mode
const DIRECT_RX_OFFSET: u32 = 0x00000008
const DIRECT_RX_DIRECT_RX_MASK: u32 = 0x0000ffff
const DIRECT_RX_DIRECT_RX_SHIFT: u32 = 0

