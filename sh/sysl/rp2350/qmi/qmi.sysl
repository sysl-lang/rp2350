const DIRECT_CSR_RXFULL_SHIFT: u32 = 17
const DIRECT_CSR_RXEMPTY_MASK: u32 = 0x00010000
const DIRECT_CSR_RXEMPTY_SHIFT: u32 = 16
const DIRECT_CSR_TXLEVEL_MASK: u32 = 0x00007000
const DIRECT_CSR_TXLEVEL_SHIFT: u32 = 12
const DIRECT_CSR_TXEMPTY_MASK: u32 = 0x00000800
const DIRECT_CSR_TXEMPTY_SHIFT: u32 = 11
const DIRECT_CSR_TXFULL_MASK: u32 = 0x00000400
const DIRECT_CSR_TXFULL_SHIFT: u32 = 10
const DIRECT_CSR_AUTO_CS1N_MASK: u32 = 0x00000080
const DIRECT_CSR_AUTO_CS1N_SHIFT: u32 = 7
const DIRECT_CSR_AUTO_CS0N_MASK: u32 = 0x00000040
const DIRECT_CSR_AUTO_CS0N_SHIFT: u32 = 6
const DIRECT_CSR_ASSERT_CS1N_MASK: u32 = 0x00000008
const DIRECT_CSR_ASSERT_CS1N_SHIFT: u32 = 3
const DIRECT_CSR_ASSERT_CS0N_MASK: u32 = 0x00000004
const DIRECT_CSR_ASSERT_CS0N_SHIFT: u32 = 2
const DIRECT_CSR_BUSY_MASK: u32 = 0x00000002
const DIRECT_CSR_BUSY_SHIFT: u32 = 1
const DIRECT_CSR_EN_MASK: u32 = 0x00000001
const DIRECT_CSR_EN_SHIFT: u32 = 0

// Transmit FIFO for direct mode
const DIRECT_TX_OFFSET: u32 = 0x00000004
const DIRECT_TX_NOPUSH_MASK: u32 = 0x00100000
const DIRECT_TX_NOPUSH_SHIFT: u32 = 20
const DIRECT_TX_OE_MASK: u32 = 0x00080000
