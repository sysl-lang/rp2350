// Controls the crystal oscillator

module sh.sysl.rp2350.xosc

// The peripheral's base address. Every offset below is from here.
const BASE: u32 = 0x40048000

// Crystal Oscillator Control
const CTRL_OFFSET: u32 = 0x00000000
const CTRL_ENABLE_MASK: u32 = 0x00fff000
const CTRL_ENABLE_SHIFT: u32 = 12
const CTRL_ENABLE_DISABLE: u32 = 3358
const CTRL_ENABLE_ENABLE: u32 = 4011
const CTRL_FREQ_RANGE_MASK: u32 = 0x00000fff
const CTRL_FREQ_RANGE_SHIFT: u32 = 0
const CTRL_FREQ_RANGE_1_15MHZ: u32 = 2720
const CTRL_FREQ_RANGE_10_30MHZ: u32 = 2721
const CTRL_FREQ_RANGE_25_60MHZ: u32 = 2722
const CTRL_FREQ_RANGE_40_100MHZ: u32 = 2723

// Crystal Oscillator Status
const STATUS_OFFSET: u32 = 0x00000004
const STATUS_STABLE_MASK: u32 = 0x80000000
const STATUS_STABLE_SHIFT: u32 = 31
const STATUS_BADWRITE_MASK: u32 = 0x01000000
const STATUS_BADWRITE_SHIFT: u32 = 24
const STATUS_ENABLED_MASK: u32 = 0x00001000
const STATUS_ENABLED_SHIFT: u32 = 12
const STATUS_FREQ_RANGE_MASK: u32 = 0x00000003
const STATUS_FREQ_RANGE_SHIFT: u32 = 0
const STATUS_FREQ_RANGE_1_15MHZ: u32 = 0
const STATUS_FREQ_RANGE_10_30MHZ: u32 = 1
const STATUS_FREQ_RANGE_25_60MHZ: u32 = 2
const STATUS_FREQ_RANGE_40_100MHZ: u32 = 3

// Crystal Oscillator pause control
const DORMANT_OFFSET: u32 = 0x00000008
const DORMANT_DORMANT_MASK: u32 = 0xffffffff
const DORMANT_DORMANT_SHIFT: u32 = 0
const DORMANT_DORMANT_DORMANT: u32 = 1668246881
const DORMANT_DORMANT_WAKE: u32 = 2002873189

// Controls the startup delay
const STARTUP_OFFSET: u32 = 0x0000000c
const STARTUP_X4_MASK: u32 = 0x00100000
const STARTUP_X4_SHIFT: u32 = 20
const STARTUP_DELAY_MASK: u32 = 0x00003fff
const STARTUP_DELAY_SHIFT: u32 = 0

// A down counter running at the xosc frequency which counts to zero and stops. Can be used for
// short software pauses when setting up time sensitive hardware. To start the counter, write a
// non-zero value. Reads will return 1 while the count is running and 0 when it has finished.
// Minimum count value is 4. Count values <4 will be treated as count value =4. Note that
// synchronisation to the register clock domain costs 2 register clock cycles and the counter
// cannot compensate for that.
const COUNT_OFFSET: u32 = 0x00000010
const COUNT_COUNT_MASK: u32 = 0x0000ffff
const COUNT_COUNT_SHIFT: u32 = 0
