const IC_CLR_ACTIVITY_CLR_ACTIVITY_MASK: u32 = 0x00000001
const IC_CLR_ACTIVITY_CLR_ACTIVITY_SHIFT: u32 = 0

// Clear STOP_DET Interrupt Register
const IC_CLR_STOP_DET_OFFSET: u32 = 0x00000060
const IC_CLR_STOP_DET_CLR_STOP_DET_MASK: u32 = 0x00000001
const IC_CLR_STOP_DET_CLR_STOP_DET_SHIFT: u32 = 0

// Clear START_DET Interrupt Register
const IC_CLR_START_DET_OFFSET: u32 = 0x00000064
const IC_CLR_START_DET_CLR_START_DET_MASK: u32 = 0x00000001
const IC_CLR_START_DET_CLR_START_DET_SHIFT: u32 = 0

// Clear GEN_CALL Interrupt Register
const IC_CLR_GEN_CALL_OFFSET: u32 = 0x00000068
const IC_CLR_GEN_CALL_CLR_GEN_CALL_MASK: u32 = 0x00000001
const IC_CLR_GEN_CALL_CLR_GEN_CALL_SHIFT: u32 = 0

// I2C Enable Register
const IC_ENABLE_OFFSET: u32 = 0x0000006c
const IC_ENABLE_TX_CMD_BLOCK_MASK: u32 = 0x00000004
const IC_ENABLE_TX_CMD_BLOCK_SHIFT: u32 = 2
const IC_ENABLE_TX_CMD_BLOCK_NOT_BLOCKED: u32 = 0
const IC_ENABLE_TX_CMD_BLOCK_BLOCKED: u32 = 1
const IC_ENABLE_ABORT_MASK: u32 = 0x00000002
const IC_ENABLE_ABORT_SHIFT: u32 = 1
const IC_ENABLE_ABORT_DISABLE: u32 = 0
const IC_ENABLE_ABORT_ENABLED: u32 = 1
const IC_ENABLE_ENABLE_MASK: u32 = 0x00000001
const IC_ENABLE_ENABLE_SHIFT: u32 = 0
const IC_ENABLE_ENABLE_DISABLED: u32 = 0
const IC_ENABLE_ENABLE_ENABLED: u32 = 1

// I2C Status Register This is a read-only register used to indicate the current transfer status
// and FIFO status. The status register may be read at any time. None of the bits in this register
// request an interrupt. When the I2C is disabled by writing 0 in bit 0 of the IC_ENABLE register:
// - Bits 1 and 2 are set to 1 - Bits 3 and 10 are set to 0 When the master or slave state machines
// goes to idle and ic_en=0: - Bits 5 and 6 are set to 0
const IC_STATUS_OFFSET: u32 = 0x00000070
const IC_STATUS_SLV_ACTIVITY_MASK: u32 = 0x00000040
const IC_STATUS_SLV_ACTIVITY_SHIFT: u32 = 6
const IC_STATUS_SLV_ACTIVITY_IDLE: u32 = 0
const IC_STATUS_SLV_ACTIVITY_ACTIVE: u32 = 1
const IC_STATUS_MST_ACTIVITY_MASK: u32 = 0x00000020
const IC_STATUS_MST_ACTIVITY_SHIFT: u32 = 5
const IC_STATUS_MST_ACTIVITY_IDLE: u32 = 0
const IC_STATUS_MST_ACTIVITY_ACTIVE: u32 = 1
const IC_STATUS_RFF_MASK: u32 = 0x00000010
const IC_STATUS_RFF_SHIFT: u32 = 4
const IC_STATUS_RFF_NOT_FULL: u32 = 0
const IC_STATUS_RFF_FULL: u32 = 1
const IC_STATUS_RFNE_MASK: u32 = 0x00000008
const IC_STATUS_RFNE_SHIFT: u32 = 3
const IC_STATUS_RFNE_EMPTY: u32 = 0
const IC_STATUS_RFNE_NOT_EMPTY: u32 = 1
const IC_STATUS_TFE_MASK: u32 = 0x00000004
const IC_STATUS_TFE_SHIFT: u32 = 2
const IC_STATUS_TFE_NON_EMPTY: u32 = 0
const IC_STATUS_TFE_EMPTY: u32 = 1
const IC_STATUS_TFNF_MASK: u32 = 0x00000002
const IC_STATUS_TFNF_SHIFT: u32 = 1
const IC_STATUS_TFNF_FULL: u32 = 0
const IC_STATUS_TFNF_NOT_FULL: u32 = 1
const IC_STATUS_ACTIVITY_MASK: u32 = 0x00000001
const IC_STATUS_ACTIVITY_SHIFT: u32 = 0
const IC_STATUS_ACTIVITY_INACTIVE: u32 = 0
const IC_STATUS_ACTIVITY_ACTIVE: u32 = 1

// I2C Transmit FIFO Level Register This register contains the number of valid data entries in the
// transmit FIFO buffer. It is cleared whenever: - The I2C is disabled - There is a transmit abort
// - that is, TX_ABRT bit is set in the IC_RAW_INTR_STAT register - The slave bulk transmit mode is
// aborted The register increments whenever data is placed into the transmit FIFO and decrements
// when data is taken from the transmit FIFO.
const IC_TXFLR_OFFSET: u32 = 0x00000074
const IC_TXFLR_TXFLR_MASK: u32 = 0x0000001f
const IC_TXFLR_TXFLR_SHIFT: u32 = 0

// I2C Receive FIFO Level Register This register contains the number of valid data entries in the
// receive FIFO buffer. It is cleared whenever: - The I2C is disabled - Whenever there is a
// transmit abort caused by any of the events tracked in IC_TX_ABRT_SOURCE The register increments
// whenever data is placed into the receive FIFO and decrements when data is taken from the receive
// FIFO.
const IC_RXFLR_OFFSET: u32 = 0x00000078
const IC_RXFLR_RXFLR_MASK: u32 = 0x0000001f
const IC_RXFLR_RXFLR_SHIFT: u32 = 0

// I2C SDA Hold Time Length Register The bits [15:0] of this register are used to control the hold
// time of SDA during transmit in both slave and master mode (after SCL goes from HIGH to LOW). The
// bits [23:16] of this register are used to extend the SDA transition (if any) whenever SCL is
// HIGH in the receiver in either master or slave mode. Writes to this register succeed only when
// IC_ENABLE[0]=0. The values in this register are in units of ic_clk period. The value programmed
// in IC_SDA_TX_HOLD must be greater than the minimum hold time in each mode (one cycle in master
// mode, seven cycles in slave mode) for the value to be implemented. The programmed SDA hold time
// during transmit (IC_SDA_TX_HOLD) cannot exceed at any time the duration of the low part of scl.
// Therefore the programmed value cannot be larger than N_SCL_LOW-2, where N_SCL_LOW is the
// duration of the low part of the scl period measured in ic_clk cycles.
const IC_SDA_HOLD_OFFSET: u32 = 0x0000007c
const IC_SDA_HOLD_IC_SDA_RX_HOLD_MASK: u32 = 0x00ff0000
const IC_SDA_HOLD_IC_SDA_RX_HOLD_SHIFT: u32 = 16
const IC_SDA_HOLD_IC_SDA_TX_HOLD_MASK: u32 = 0x0000ffff
const IC_SDA_HOLD_IC_SDA_TX_HOLD_SHIFT: u32 = 0

// I2C Transmit Abort Source Register This register has 32 bits that indicate the source of the
// TX_ABRT bit. Except for Bit 9, this register is cleared whenever the IC_CLR_TX_ABRT register or
// the IC_CLR_INTR register is read. To clear Bit 9, the source of the ABRT_SBYTE_NORSTRT must be
// fixed first; RESTART must be enabled (IC_CON[5]=1), the SPECIAL bit must be cleared
// (IC_TAR[11]), or the GC_OR_START bit must be cleared (IC_TAR[10]). Once the source of the
// ABRT_SBYTE_NORSTRT is fixed, then this bit can be cleared in the same manner as other bits in
// this register. If the source of the ABRT_SBYTE_NORSTRT is not fixed before attempting to clear
// this bit, Bit 9 clears for one cycle and is then re-asserted.
const IC_TX_ABRT_SOURCE_OFFSET: u32 = 0x00000080
const IC_TX_ABRT_SOURCE_TX_FLUSH_CNT_MASK: u32 = 0xff800000
const IC_TX_ABRT_SOURCE_TX_FLUSH_CNT_SHIFT: u32 = 23
const IC_TX_ABRT_SOURCE_ABRT_USER_ABRT_MASK: u32 = 0x00010000
const IC_TX_ABRT_SOURCE_ABRT_USER_ABRT_SHIFT: u32 = 16
const IC_TX_ABRT_SOURCE_ABRT_USER_ABRT_ABRT_USER_ABRT_VOID: u32 = 0
const IC_TX_ABRT_SOURCE_ABRT_USER_ABRT_ABRT_USER_ABRT_GENERATED: u32 = 1
const IC_TX_ABRT_SOURCE_ABRT_SLVRD_INTX_MASK: u32 = 0x00008000
const IC_TX_ABRT_SOURCE_ABRT_SLVRD_INTX_SHIFT: u32 = 15
const IC_TX_ABRT_SOURCE_ABRT_SLVRD_INTX_ABRT_SLVRD_INTX_VOID: u32 = 0
const IC_TX_ABRT_SOURCE_ABRT_SLVRD_INTX_ABRT_SLVRD_INTX_GENERATED: u32 = 1
const IC_TX_ABRT_SOURCE_ABRT_SLV_ARBLOST_MASK: u32 = 0x00004000
const IC_TX_ABRT_SOURCE_ABRT_SLV_ARBLOST_SHIFT: u32 = 14
const IC_TX_ABRT_SOURCE_ABRT_SLV_ARBLOST_ABRT_SLV_ARBLOST_VOID: u32 = 0
const IC_TX_ABRT_SOURCE_ABRT_SLV_ARBLOST_ABRT_SLV_ARBLOST_GENERATED: u32 = 1
const IC_TX_ABRT_SOURCE_ABRT_SLVFLUSH_TXFIFO_MASK: u32 = 0x00002000
const IC_TX_ABRT_SOURCE_ABRT_SLVFLUSH_TXFIFO_SHIFT: u32 = 13
const IC_TX_ABRT_SOURCE_ABRT_SLVFLUSH_TXFIFO_ABRT_SLVFLUSH_TXFIFO_VOID: u32 = 0
const IC_TX_ABRT_SOURCE_ABRT_SLVFLUSH_TXFIFO_ABRT_SLVFLUSH_TXFIFO_GENERATED: u32 = 1
const IC_TX_ABRT_SOURCE_ARB_LOST_MASK: u32 = 0x00001000
const IC_TX_ABRT_SOURCE_ARB_LOST_SHIFT: u32 = 12
const IC_TX_ABRT_SOURCE_ARB_LOST_ABRT_LOST_VOID: u32 = 0
const IC_TX_ABRT_SOURCE_ARB_LOST_ABRT_LOST_GENERATED: u32 = 1
const IC_TX_ABRT_SOURCE_ABRT_MASTER_DIS_MASK: u32 = 0x00000800
const IC_TX_ABRT_SOURCE_ABRT_MASTER_DIS_SHIFT: u32 = 11
const IC_TX_ABRT_SOURCE_ABRT_MASTER_DIS_ABRT_MASTER_DIS_VOID: u32 = 0
const IC_TX_ABRT_SOURCE_ABRT_MASTER_DIS_ABRT_MASTER_DIS_GENERATED: u32 = 1
const IC_TX_ABRT_SOURCE_ABRT_10B_RD_NORSTRT_MASK: u32 = 0x00000400
const IC_TX_ABRT_SOURCE_ABRT_10B_RD_NORSTRT_SHIFT: u32 = 10
const IC_TX_ABRT_SOURCE_ABRT_10B_RD_NORSTRT_ABRT_10B_RD_VOID: u32 = 0
const IC_TX_ABRT_SOURCE_ABRT_10B_RD_NORSTRT_ABRT_10B_RD_GENERATED: u32 = 1
const IC_TX_ABRT_SOURCE_ABRT_SBYTE_NORSTRT_MASK: u32 = 0x00000200
const IC_TX_ABRT_SOURCE_ABRT_SBYTE_NORSTRT_SHIFT: u32 = 9
const IC_TX_ABRT_SOURCE_ABRT_SBYTE_NORSTRT_ABRT_SBYTE_NORSTRT_VOID: u32 = 0
const IC_TX_ABRT_SOURCE_ABRT_SBYTE_NORSTRT_ABRT_SBYTE_NORSTRT_GENERATED: u32 = 1
const IC_TX_ABRT_SOURCE_ABRT_HS_NORSTRT_MASK: u32 = 0x00000100
const IC_TX_ABRT_SOURCE_ABRT_HS_NORSTRT_SHIFT: u32 = 8
const IC_TX_ABRT_SOURCE_ABRT_HS_NORSTRT_ABRT_HS_NORSTRT_VOID: u32 = 0
const IC_TX_ABRT_SOURCE_ABRT_HS_NORSTRT_ABRT_HS_NORSTRT_GENERATED: u32 = 1
const IC_TX_ABRT_SOURCE_ABRT_SBYTE_ACKDET_MASK: u32 = 0x00000080
const IC_TX_ABRT_SOURCE_ABRT_SBYTE_ACKDET_SHIFT: u32 = 7
const IC_TX_ABRT_SOURCE_ABRT_SBYTE_ACKDET_ABRT_SBYTE_ACKDET_VOID: u32 = 0
const IC_TX_ABRT_SOURCE_ABRT_SBYTE_ACKDET_ABRT_SBYTE_ACKDET_GENERATED: u32 = 1
const IC_TX_ABRT_SOURCE_ABRT_HS_ACKDET_MASK: u32 = 0x00000040
const IC_TX_ABRT_SOURCE_ABRT_HS_ACKDET_SHIFT: u32 = 6
const IC_TX_ABRT_SOURCE_ABRT_HS_ACKDET_ABRT_HS_ACK_VOID: u32 = 0
const IC_TX_ABRT_SOURCE_ABRT_HS_ACKDET_ABRT_HS_ACK_GENERATED: u32 = 1
const IC_TX_ABRT_SOURCE_ABRT_GCALL_READ_MASK: u32 = 0x00000020
const IC_TX_ABRT_SOURCE_ABRT_GCALL_READ_SHIFT: u32 = 5
const IC_TX_ABRT_SOURCE_ABRT_GCALL_READ_ABRT_GCALL_READ_VOID: u32 = 0
const IC_TX_ABRT_SOURCE_ABRT_GCALL_READ_ABRT_GCALL_READ_GENERATED: u32 = 1
const IC_TX_ABRT_SOURCE_ABRT_GCALL_NOACK_MASK: u32 = 0x00000010
const IC_TX_ABRT_SOURCE_ABRT_GCALL_NOACK_SHIFT: u32 = 4
const IC_TX_ABRT_SOURCE_ABRT_GCALL_NOACK_ABRT_GCALL_NOACK_VOID: u32 = 0
const IC_TX_ABRT_SOURCE_ABRT_GCALL_NOACK_ABRT_GCALL_NOACK_GENERATED: u32 = 1
const IC_TX_ABRT_SOURCE_ABRT_TXDATA_NOACK_MASK: u32 = 0x00000008
const IC_TX_ABRT_SOURCE_ABRT_TXDATA_NOACK_SHIFT: u32 = 3
const IC_TX_ABRT_SOURCE_ABRT_TXDATA_NOACK_ABRT_TXDATA_NOACK_VOID: u32 = 0
const IC_TX_ABRT_SOURCE_ABRT_TXDATA_NOACK_ABRT_TXDATA_NOACK_GENERATED: u32 = 1
const IC_TX_ABRT_SOURCE_ABRT_10ADDR2_NOACK_MASK: u32 = 0x00000004
const IC_TX_ABRT_SOURCE_ABRT_10ADDR2_NOACK_SHIFT: u32 = 2
const IC_TX_ABRT_SOURCE_ABRT_10ADDR2_NOACK_INACTIVE: u32 = 0
const IC_TX_ABRT_SOURCE_ABRT_10ADDR2_NOACK_ACTIVE: u32 = 1
const IC_TX_ABRT_SOURCE_ABRT_10ADDR1_NOACK_MASK: u32 = 0x00000002
const IC_TX_ABRT_SOURCE_ABRT_10ADDR1_NOACK_SHIFT: u32 = 1
const IC_TX_ABRT_SOURCE_ABRT_10ADDR1_NOACK_INACTIVE: u32 = 0
