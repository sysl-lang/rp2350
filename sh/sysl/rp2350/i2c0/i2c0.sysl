const IC_TX_ABRT_SOURCE_ABRT_7B_ADDR_NOACK_MASK: u32 = 0x00000001
const IC_TX_ABRT_SOURCE_ABRT_7B_ADDR_NOACK_SHIFT: u32 = 0
