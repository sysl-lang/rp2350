const IC_TX_ABRT_SOURCE_ABRT_7B_ADDR_NOACK_ACTIVE: u32 = 1

// Generate Slave Data NACK Register The register is used to generate a NACK for the data part of a
// transfer when DW_apb_i2c is acting as a slave-receiver. This register only exists when the
// IC_SLV_DATA_NACK_ONLY parameter is set to 1. When this parameter disabled, this register does
// not exist and writing to the register's address has no effect. A write can occur on this
// register if both of the following conditions are met: - DW_apb_i2c is disabled (IC_ENABLE[0] =
// 0) - Slave part is inactive (IC_STATUS[6] = 0) Note: The IC_STATUS[6] is a register read-back
// location for the internal slv_activity signal; the user should poll this before writing the
// ic_slv_data_nack_only bit.
const IC_SLV_DATA_NACK_ONLY_OFFSET: u32 = 0x00000084
const IC_SLV_DATA_NACK_ONLY_NACK_MASK: u32 = 0x00000001
const IC_SLV_DATA_NACK_ONLY_NACK_SHIFT: u32 = 0
const IC_SLV_DATA_NACK_ONLY_NACK_DISABLED: u32 = 0
const IC_SLV_DATA_NACK_ONLY_NACK_ENABLED: u32 = 1

// DMA Control Register The register is used to enable the DMA Controller interface operation.
// There is a separate bit for transmit and receive. This can be programmed regardless of the state
// of IC_ENABLE.
const IC_DMA_CR_OFFSET: u32 = 0x00000088
const IC_DMA_CR_TDMAE_MASK: u32 = 0x00000002
const IC_DMA_CR_TDMAE_SHIFT: u32 = 1
const IC_DMA_CR_TDMAE_DISABLED: u32 = 0
const IC_DMA_CR_TDMAE_ENABLED: u32 = 1
const IC_DMA_CR_RDMAE_MASK: u32 = 0x00000001
const IC_DMA_CR_RDMAE_SHIFT: u32 = 0
const IC_DMA_CR_RDMAE_DISABLED: u32 = 0
const IC_DMA_CR_RDMAE_ENABLED: u32 = 1

// DMA Transmit Data Level Register
const IC_DMA_TDLR_OFFSET: u32 = 0x0000008c
const IC_DMA_TDLR_DMATDL_MASK: u32 = 0x0000000f
const IC_DMA_TDLR_DMATDL_SHIFT: u32 = 0

// I2C Receive Data Level Register
const IC_DMA_RDLR_OFFSET: u32 = 0x00000090
const IC_DMA_RDLR_DMARDL_MASK: u32 = 0x0000000f
const IC_DMA_RDLR_DMARDL_SHIFT: u32 = 0

// I2C SDA Setup Register This register controls the amount of time delay (in terms of number of
// ic_clk clock periods) introduced in the rising edge of SCL - relative to SDA changing - when
// DW_apb_i2c services a read request in a slave-transmitter operation. The relevant I2C
// requirement is tSU:DAT (note 4) as detailed in the I2C Bus Specification. This register must be
// programmed with a value equal to or greater than 2. Writes to this register succeed only when
// IC_ENABLE[0] = 0. Note: The length of setup time is calculated using [(IC_SDA_SETUP - 1) *
// (ic_clk_period)], so if the user requires 10 ic_clk periods of setup time, they should program a
// value of 11. The IC_SDA_SETUP register is only used by the DW_apb_i2c when operating as a slave
// transmitter.
const IC_SDA_SETUP_OFFSET: u32 = 0x00000094
const IC_SDA_SETUP_SDA_SETUP_MASK: u32 = 0x000000ff
const IC_SDA_SETUP_SDA_SETUP_SHIFT: u32 = 0

// I2C ACK General Call Register The register controls whether DW_apb_i2c responds with a ACK or
// NACK when it receives an I2C General Call address. This register is applicable only when the
// DW_apb_i2c is in slave mode.
const IC_ACK_GENERAL_CALL_OFFSET: u32 = 0x00000098
const IC_ACK_GENERAL_CALL_ACK_GEN_CALL_MASK: u32 = 0x00000001
const IC_ACK_GENERAL_CALL_ACK_GEN_CALL_SHIFT: u32 = 0
const IC_ACK_GENERAL_CALL_ACK_GEN_CALL_DISABLED: u32 = 0
const IC_ACK_GENERAL_CALL_ACK_GEN_CALL_ENABLED: u32 = 1

// I2C Enable Status Register The register is used to report the DW_apb_i2c hardware status when
// the IC_ENABLE[0] register is set from 1 to 0; that is, when DW_apb_i2c is disabled. If
// IC_ENABLE[0] has been set to 1, bits 2:1 are forced to 0, and bit 0 is forced to 1. If
// IC_ENABLE[0] has been set to 0, bits 2:1 is only be valid as soon as bit 0 is read as '0'. Note:
// When IC_ENABLE[0] has been set to 0, a delay occurs for bit 0 to be read as 0 because disabling
// the DW_apb_i2c depends on I2C bus activities.
const IC_ENABLE_STATUS_OFFSET: u32 = 0x0000009c
const IC_ENABLE_STATUS_SLV_RX_DATA_LOST_MASK: u32 = 0x00000004
const IC_ENABLE_STATUS_SLV_RX_DATA_LOST_SHIFT: u32 = 2
const IC_ENABLE_STATUS_SLV_RX_DATA_LOST_INACTIVE: u32 = 0
const IC_ENABLE_STATUS_SLV_RX_DATA_LOST_ACTIVE: u32 = 1
const IC_ENABLE_STATUS_SLV_DISABLED_WHILE_BUSY_MASK: u32 = 0x00000002
const IC_ENABLE_STATUS_SLV_DISABLED_WHILE_BUSY_SHIFT: u32 = 1
const IC_ENABLE_STATUS_SLV_DISABLED_WHILE_BUSY_INACTIVE: u32 = 0
const IC_ENABLE_STATUS_SLV_DISABLED_WHILE_BUSY_ACTIVE: u32 = 1
const IC_ENABLE_STATUS_IC_EN_MASK: u32 = 0x00000001
const IC_ENABLE_STATUS_IC_EN_SHIFT: u32 = 0
const IC_ENABLE_STATUS_IC_EN_DISABLED: u32 = 0
const IC_ENABLE_STATUS_IC_EN_ENABLED: u32 = 1

// I2C SS, FS or FM+ spike suppression limit This register is used to store the duration, measured
// in ic_clk cycles, of the longest spike that is filtered out by the spike suppression logic when
// the component is operating in SS, FS or FM+ modes. The relevant I2C requirement is tSP (table 4)
// as detailed in the I2C Bus Specification. This register must be programmed with a minimum value
// of 1.
const IC_FS_SPKLEN_OFFSET: u32 = 0x000000a0
const IC_FS_SPKLEN_IC_FS_SPKLEN_MASK: u32 = 0x000000ff
const IC_FS_SPKLEN_IC_FS_SPKLEN_SHIFT: u32 = 0

// Clear RESTART_DET Interrupt Register
const IC_CLR_RESTART_DET_OFFSET: u32 = 0x000000a8
const IC_CLR_RESTART_DET_CLR_RESTART_DET_MASK: u32 = 0x00000001
const IC_CLR_RESTART_DET_CLR_RESTART_DET_SHIFT: u32 = 0

// Component Parameter Register 1 Note This register is not implemented and therefore reads as 0.
// If it was implemented it would be a constant read-only register that contains encoded
// information about the component's parameter settings. Fields shown below are the settings for
// those parameters
const IC_COMP_PARAM_1_OFFSET: u32 = 0x000000f4
const IC_COMP_PARAM_1_TX_BUFFER_DEPTH_MASK: u32 = 0x00ff0000
const IC_COMP_PARAM_1_TX_BUFFER_DEPTH_SHIFT: u32 = 16
const IC_COMP_PARAM_1_RX_BUFFER_DEPTH_MASK: u32 = 0x0000ff00
const IC_COMP_PARAM_1_RX_BUFFER_DEPTH_SHIFT: u32 = 8
const IC_COMP_PARAM_1_ADD_ENCODED_PARAMS_MASK: u32 = 0x00000080
const IC_COMP_PARAM_1_ADD_ENCODED_PARAMS_SHIFT: u32 = 7
const IC_COMP_PARAM_1_HAS_DMA_MASK: u32 = 0x00000040
const IC_COMP_PARAM_1_HAS_DMA_SHIFT: u32 = 6
const IC_COMP_PARAM_1_INTR_IO_MASK: u32 = 0x00000020
const IC_COMP_PARAM_1_INTR_IO_SHIFT: u32 = 5
const IC_COMP_PARAM_1_HC_COUNT_VALUES_MASK: u32 = 0x00000010
const IC_COMP_PARAM_1_HC_COUNT_VALUES_SHIFT: u32 = 4
const IC_COMP_PARAM_1_MAX_SPEED_MODE_MASK: u32 = 0x0000000c
const IC_COMP_PARAM_1_MAX_SPEED_MODE_SHIFT: u32 = 2
const IC_COMP_PARAM_1_APB_DATA_WIDTH_MASK: u32 = 0x00000003
const IC_COMP_PARAM_1_APB_DATA_WIDTH_SHIFT: u32 = 0

// I2C Component Version Register
const IC_COMP_VERSION_OFFSET: u32 = 0x000000f8
const IC_COMP_VERSION_IC_COMP_VERSION_MASK: u32 = 0xffffffff
const IC_COMP_VERSION_IC_COMP_VERSION_SHIFT: u32 = 0

// I2C Component Type Register
const IC_COMP_TYPE_OFFSET: u32 = 0x000000fc
const IC_COMP_TYPE_IC_COMP_TYPE_MASK: u32 = 0xffffffff
const IC_COMP_TYPE_IC_COMP_TYPE_SHIFT: u32 = 0
