const IC_INTR_STAT_R_START_DET_SHIFT: u32 = 10
const IC_INTR_STAT_R_START_DET_INACTIVE: u32 = 0
const IC_INTR_STAT_R_START_DET_ACTIVE: u32 = 1
const IC_INTR_STAT_R_STOP_DET_MASK: u32 = 0x00000200
const IC_INTR_STAT_R_STOP_DET_SHIFT: u32 = 9
const IC_INTR_STAT_R_STOP_DET_INACTIVE: u32 = 0
const IC_INTR_STAT_R_STOP_DET_ACTIVE: u32 = 1
const IC_INTR_STAT_R_ACTIVITY_MASK: u32 = 0x00000100
const IC_INTR_STAT_R_ACTIVITY_SHIFT: u32 = 8
const IC_INTR_STAT_R_ACTIVITY_INACTIVE: u32 = 0
const IC_INTR_STAT_R_ACTIVITY_ACTIVE: u32 = 1
const IC_INTR_STAT_R_RX_DONE_MASK: u32 = 0x00000080
const IC_INTR_STAT_R_RX_DONE_SHIFT: u32 = 7
const IC_INTR_STAT_R_RX_DONE_INACTIVE: u32 = 0
const IC_INTR_STAT_R_RX_DONE_ACTIVE: u32 = 1
const IC_INTR_STAT_R_TX_ABRT_MASK: u32 = 0x00000040
const IC_INTR_STAT_R_TX_ABRT_SHIFT: u32 = 6
const IC_INTR_STAT_R_TX_ABRT_INACTIVE: u32 = 0
const IC_INTR_STAT_R_TX_ABRT_ACTIVE: u32 = 1
const IC_INTR_STAT_R_RD_REQ_MASK: u32 = 0x00000020
const IC_INTR_STAT_R_RD_REQ_SHIFT: u32 = 5
const IC_INTR_STAT_R_RD_REQ_INACTIVE: u32 = 0
const IC_INTR_STAT_R_RD_REQ_ACTIVE: u32 = 1
const IC_INTR_STAT_R_TX_EMPTY_MASK: u32 = 0x00000010
const IC_INTR_STAT_R_TX_EMPTY_SHIFT: u32 = 4
const IC_INTR_STAT_R_TX_EMPTY_INACTIVE: u32 = 0
const IC_INTR_STAT_R_TX_EMPTY_ACTIVE: u32 = 1
const IC_INTR_STAT_R_TX_OVER_MASK: u32 = 0x00000008
const IC_INTR_STAT_R_TX_OVER_SHIFT: u32 = 3
const IC_INTR_STAT_R_TX_OVER_INACTIVE: u32 = 0
const IC_INTR_STAT_R_TX_OVER_ACTIVE: u32 = 1
const IC_INTR_STAT_R_RX_FULL_MASK: u32 = 0x00000004
const IC_INTR_STAT_R_RX_FULL_SHIFT: u32 = 2
const IC_INTR_STAT_R_RX_FULL_INACTIVE: u32 = 0
const IC_INTR_STAT_R_RX_FULL_ACTIVE: u32 = 1
const IC_INTR_STAT_R_RX_OVER_MASK: u32 = 0x00000002
const IC_INTR_STAT_R_RX_OVER_SHIFT: u32 = 1
const IC_INTR_STAT_R_RX_OVER_INACTIVE: u32 = 0
const IC_INTR_STAT_R_RX_OVER_ACTIVE: u32 = 1
const IC_INTR_STAT_R_RX_UNDER_MASK: u32 = 0x00000001
const IC_INTR_STAT_R_RX_UNDER_SHIFT: u32 = 0
const IC_INTR_STAT_R_RX_UNDER_INACTIVE: u32 = 0
const IC_INTR_STAT_R_RX_UNDER_ACTIVE: u32 = 1

// I2C Interrupt Mask Register. These bits mask their corresponding interrupt status bits. This
// register is active low; a value of 0 masks the interrupt, whereas a value of 1 unmasks the
// interrupt.
const IC_INTR_MASK_OFFSET: u32 = 0x00000030
const IC_INTR_MASK_M_RESTART_DET_MASK: u32 = 0x00001000
const IC_INTR_MASK_M_RESTART_DET_SHIFT: u32 = 12
