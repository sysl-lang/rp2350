// DW_apb_i2c address block List of configuration constants for the Synopsys I2C hardware (you may
// see references to these in I2C register header; these are *fixed* values, set at hardware design
// time): IC_ULTRA_FAST_MODE ................ 0x0 IC_UFM_TBUF_CNT_DEFAULT ........... 0x8
// IC_UFM_SCL_LOW_COUNT .............. 0x0008 IC_UFM_SCL_HIGH_COUNT ............. 0x0006 IC_TX_TL
// .......................... 0x0 IC_TX_CMD_BLOCK ................... 0x1 IC_HAS_DMA
// ........................ 0x1 IC_HAS_ASYNC_FIFO ................. 0x0 IC_SMBUS_ARP
// ...................... 0x0 IC_FIRST_DATA_BYTE_STATUS ......... 0x1 IC_INTR_IO
// ........................ 0x1 IC_MASTER_MODE .................... 0x1 IC_DEFAULT_ACK_GENERAL_CALL
// ....... 0x1 IC_INTR_POL ....................... 0x1 IC_OPTIONAL_SAR ................... 0x0
// IC_DEFAULT_TAR_SLAVE_ADDR ......... 0x055 IC_DEFAULT_SLAVE_ADDR ............. 0x055
// IC_DEFAULT_HS_SPKLEN .............. 0x1 IC_FS_SCL_HIGH_COUNT .............. 0x0006
// IC_HS_SCL_LOW_COUNT ............... 0x0008 IC_DEVICE_ID_VALUE ................ 0x0
// IC_10BITADDR_MASTER ............... 0x0 IC_CLK_FREQ_OPTIMIZATION .......... 0x0
// IC_DEFAULT_FS_SPKLEN .............. 0x7 IC_ADD_ENCODED_PARAMS ............. 0x0
// IC_DEFAULT_SDA_HOLD ............... 0x000001 IC_DEFAULT_SDA_SETUP .............. 0x64
// IC_AVOID_RX_FIFO_FLUSH_ON_TX_ABRT . 0x0 IC_CLOCK_PERIOD ................... 100
// IC_EMPTYFIFO_HOLD_MASTER_EN ....... 1 IC_RESTART_EN ..................... 0x1
// IC_TX_CMD_BLOCK_DEFAULT ........... 0x0 IC_BUS_CLEAR_FEATURE .............. 0x0 IC_CAP_LOADING
// .................... 100 IC_FS_SCL_LOW_COUNT ............... 0x000d APB_DATA_WIDTH
// .................... 32 IC_SDA_STUCK_TIMEOUT_DEFAULT ...... 0xffffffff IC_SLV_DATA_NACK_ONLY
// ............. 0x1 IC_10BITADDR_SLAVE ................ 0x0 IC_CLK_TYPE .......................
// 0x0 IC_SMBUS_UDID_MSB ................. 0x0 IC_SMBUS_SUSPEND_ALERT ............ 0x0
// IC_HS_SCL_HIGH_COUNT .............. 0x0006 IC_SLV_RESTART_DET_EN ............. 0x1 IC_SMBUS
// .......................... 0x0 IC_OPTIONAL_SAR_DEFAULT ........... 0x0
// IC_PERSISTANT_SLV_ADDR_DEFAULT .... 0x0 IC_USE_COUNTS ..................... 0x0
// IC_RX_BUFFER_DEPTH ................ 16 IC_SCL_STUCK_TIMEOUT_DEFAULT ...... 0xffffffff
// IC_RX_FULL_HLD_BUS_EN ............. 0x1 IC_SLAVE_DISABLE .................. 0x1 IC_RX_TL
// .......................... 0x0 IC_DEVICE_ID ...................... 0x0 IC_HC_COUNT_VALUES
// ................ 0x0 I2C_DYNAMIC_TAR_UPDATE ............ 0 IC_SMBUS_CLK_LOW_MEXT_DEFAULT .....
// 0xffffffff IC_SMBUS_CLK_LOW_SEXT_DEFAULT ..... 0xffffffff IC_HS_MASTER_CODE .................
// 0x1 IC_SMBUS_RST_IDLE_CNT_DEFAULT ..... 0xffff IC_SMBUS_UDID_LSB_DEFAULT ......... 0xffffffff
// IC_SS_SCL_HIGH_COUNT .............. 0x0028 IC_SS_SCL_LOW_COUNT ............... 0x002f
// IC_MAX_SPEED_MODE ................. 0x2 IC_STAT_FOR_CLK_STRETCH ........... 0x0
// IC_STOP_DET_IF_MASTER_ACTIVE ...... 0x0 IC_DEFAULT_UFM_SPKLEN ............. 0x1
// IC_TX_BUFFER_DEPTH ................ 16

module sh.sysl.rp2350.i2c0

// The peripheral's base address. Every offset below is from here.
const BASE: u32 = 0x40090000

// I2C Control Register. This register can be written only when the DW_apb_i2c is disabled, which
// corresponds to the IC_ENABLE[0] register being set to 0. Writes at other times have no effect.
// Read/Write Access: - bit 10 is read only. - bit 11 is read only - bit 16 is read only - bit 17
// is read only - bits 18 and 19 are read only.
const IC_CON_OFFSET: u32 = 0x00000000
const IC_CON_STOP_DET_IF_MASTER_ACTIVE_MASK: u32 = 0x00000400
const IC_CON_STOP_DET_IF_MASTER_ACTIVE_SHIFT: u32 = 10
const IC_CON_RX_FIFO_FULL_HLD_CTRL_MASK: u32 = 0x00000200
const IC_CON_RX_FIFO_FULL_HLD_CTRL_SHIFT: u32 = 9
const IC_CON_RX_FIFO_FULL_HLD_CTRL_DISABLED: u32 = 0
const IC_CON_RX_FIFO_FULL_HLD_CTRL_ENABLED: u32 = 1
const IC_CON_TX_EMPTY_CTRL_MASK: u32 = 0x00000100
const IC_CON_TX_EMPTY_CTRL_SHIFT: u32 = 8
const IC_CON_TX_EMPTY_CTRL_DISABLED: u32 = 0
const IC_CON_TX_EMPTY_CTRL_ENABLED: u32 = 1
const IC_CON_STOP_DET_IFADDRESSED_MASK: u32 = 0x00000080
const IC_CON_STOP_DET_IFADDRESSED_SHIFT: u32 = 7
const IC_CON_STOP_DET_IFADDRESSED_DISABLED: u32 = 0
const IC_CON_STOP_DET_IFADDRESSED_ENABLED: u32 = 1
const IC_CON_IC_SLAVE_DISABLE_MASK: u32 = 0x00000040
const IC_CON_IC_SLAVE_DISABLE_SHIFT: u32 = 6
const IC_CON_IC_SLAVE_DISABLE_SLAVE_ENABLED: u32 = 0
const IC_CON_IC_SLAVE_DISABLE_SLAVE_DISABLED: u32 = 1
const IC_CON_IC_RESTART_EN_MASK: u32 = 0x00000020
const IC_CON_IC_RESTART_EN_SHIFT: u32 = 5
const IC_CON_IC_RESTART_EN_DISABLED: u32 = 0
const IC_CON_IC_RESTART_EN_ENABLED: u32 = 1
const IC_CON_IC_10BITADDR_MASTER_MASK: u32 = 0x00000010
const IC_CON_IC_10BITADDR_MASTER_SHIFT: u32 = 4
const IC_CON_IC_10BITADDR_MASTER_ADDR_7BITS: u32 = 0
const IC_CON_IC_10BITADDR_MASTER_ADDR_10BITS: u32 = 1
const IC_CON_IC_10BITADDR_SLAVE_MASK: u32 = 0x00000008
const IC_CON_IC_10BITADDR_SLAVE_SHIFT: u32 = 3
const IC_CON_IC_10BITADDR_SLAVE_ADDR_7BITS: u32 = 0
const IC_CON_IC_10BITADDR_SLAVE_ADDR_10BITS: u32 = 1
const IC_CON_SPEED_MASK: u32 = 0x00000006
const IC_CON_SPEED_SHIFT: u32 = 1
const IC_CON_SPEED_STANDARD: u32 = 1
const IC_CON_SPEED_FAST: u32 = 2
const IC_CON_SPEED_HIGH: u32 = 3
const IC_CON_MASTER_MODE_MASK: u32 = 0x00000001
const IC_CON_MASTER_MODE_SHIFT: u32 = 0
const IC_CON_MASTER_MODE_DISABLED: u32 = 0
const IC_CON_MASTER_MODE_ENABLED: u32 = 1

// I2C Target Address Register This register is 12 bits wide, and bits 31:12 are reserved. This
// register can be written to only when IC_ENABLE[0] is set to 0. Note: If the software or
// application is aware that the DW_apb_i2c is not using the TAR address for the pending commands
// in the Tx FIFO, then it is possible to update the TAR address even while the Tx FIFO has entries
// (IC_STATUS[2]= 0). - It is not necessary to perform any write to this register if DW_apb_i2c is
// enabled as an I2C slave only.
const IC_TAR_OFFSET: u32 = 0x00000004
const IC_TAR_SPECIAL_MASK: u32 = 0x00000800
const IC_TAR_SPECIAL_SHIFT: u32 = 11
const IC_TAR_SPECIAL_DISABLED: u32 = 0
const IC_TAR_SPECIAL_ENABLED: u32 = 1
const IC_TAR_GC_OR_START_MASK: u32 = 0x00000400
const IC_TAR_GC_OR_START_SHIFT: u32 = 10
const IC_TAR_GC_OR_START_GENERAL_CALL: u32 = 0
const IC_TAR_GC_OR_START_START_BYTE: u32 = 1
const IC_TAR_IC_TAR_MASK: u32 = 0x000003ff
const IC_TAR_IC_TAR_SHIFT: u32 = 0

// I2C Slave Address Register
const IC_SAR_OFFSET: u32 = 0x00000008
const IC_SAR_IC_SAR_MASK: u32 = 0x000003ff
const IC_SAR_IC_SAR_SHIFT: u32 = 0

// I2C Rx/Tx Data Buffer and Command Register; this is the register the CPU writes to when filling
// the TX FIFO and the CPU reads from when retrieving bytes from RX FIFO. The size of the register
// changes as follows: Write: - 11 bits when IC_EMPTYFIFO_HOLD_MASTER_EN=1 - 9 bits when
// IC_EMPTYFIFO_HOLD_MASTER_EN=0 Read: - 12 bits when IC_FIRST_DATA_BYTE_STATUS = 1 - 8 bits when
// IC_FIRST_DATA_BYTE_STATUS = 0 Note: In order for the DW_apb_i2c to continue acknowledging reads,
// a read command should be written for every byte that is to be received; otherwise the DW_apb_i2c
// will stop acknowledging.
const IC_DATA_CMD_OFFSET: u32 = 0x00000010
const IC_DATA_CMD_FIRST_DATA_BYTE_MASK: u32 = 0x00000800
const IC_DATA_CMD_FIRST_DATA_BYTE_SHIFT: u32 = 11
const IC_DATA_CMD_FIRST_DATA_BYTE_INACTIVE: u32 = 0
const IC_DATA_CMD_FIRST_DATA_BYTE_ACTIVE: u32 = 1
const IC_DATA_CMD_RESTART_MASK: u32 = 0x00000400
const IC_DATA_CMD_RESTART_SHIFT: u32 = 10
const IC_DATA_CMD_RESTART_DISABLE: u32 = 0
const IC_DATA_CMD_RESTART_ENABLE: u32 = 1
const IC_DATA_CMD_STOP_MASK: u32 = 0x00000200
const IC_DATA_CMD_STOP_SHIFT: u32 = 9
const IC_DATA_CMD_STOP_DISABLE: u32 = 0
const IC_DATA_CMD_STOP_ENABLE: u32 = 1
const IC_DATA_CMD_CMD_MASK: u32 = 0x00000100
const IC_DATA_CMD_CMD_SHIFT: u32 = 8
const IC_DATA_CMD_CMD_WRITE: u32 = 0
const IC_DATA_CMD_CMD_READ: u32 = 1
const IC_DATA_CMD_DAT_MASK: u32 = 0x000000ff
const IC_DATA_CMD_DAT_SHIFT: u32 = 0

// Standard Speed I2C Clock SCL High Count Register
const IC_SS_SCL_HCNT_OFFSET: u32 = 0x00000014
const IC_SS_SCL_HCNT_IC_SS_SCL_HCNT_MASK: u32 = 0x0000ffff
const IC_SS_SCL_HCNT_IC_SS_SCL_HCNT_SHIFT: u32 = 0

// Standard Speed I2C Clock SCL Low Count Register
const IC_SS_SCL_LCNT_OFFSET: u32 = 0x00000018
const IC_SS_SCL_LCNT_IC_SS_SCL_LCNT_MASK: u32 = 0x0000ffff
const IC_SS_SCL_LCNT_IC_SS_SCL_LCNT_SHIFT: u32 = 0

// Fast Mode or Fast Mode Plus I2C Clock SCL High Count Register
const IC_FS_SCL_HCNT_OFFSET: u32 = 0x0000001c
const IC_FS_SCL_HCNT_IC_FS_SCL_HCNT_MASK: u32 = 0x0000ffff
const IC_FS_SCL_HCNT_IC_FS_SCL_HCNT_SHIFT: u32 = 0

// Fast Mode or Fast Mode Plus I2C Clock SCL Low Count Register
const IC_FS_SCL_LCNT_OFFSET: u32 = 0x00000020
const IC_FS_SCL_LCNT_IC_FS_SCL_LCNT_MASK: u32 = 0x0000ffff
const IC_FS_SCL_LCNT_IC_FS_SCL_LCNT_SHIFT: u32 = 0

// I2C Interrupt Status Register Each bit in this register has a corresponding mask bit in the
// IC_INTR_MASK register. These bits are cleared by reading the matching interrupt clear register.
// The unmasked raw versions of these bits are available in the IC_RAW_INTR_STAT register.
const IC_INTR_STAT_OFFSET: u32 = 0x0000002c
const IC_INTR_STAT_R_RESTART_DET_MASK: u32 = 0x00001000
const IC_INTR_STAT_R_RESTART_DET_SHIFT: u32 = 12
