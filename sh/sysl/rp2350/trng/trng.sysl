// Arm TrustZone RNG register block

module sh.sysl.rp2350.trng

// The peripheral's base address. Every offset below is from here.
const BASE: u32 = 0x400f0000

// Interrupt masking.
const RNG_IMR_OFFSET: u32 = 0x00000100
const RNG_IMR_VN_ERR_INT_MASK_MASK: u32 = 0x00000008
const RNG_IMR_VN_ERR_INT_MASK_SHIFT: u32 = 3
const RNG_IMR_CRNGT_ERR_INT_MASK_MASK: u32 = 0x00000004
const RNG_IMR_CRNGT_ERR_INT_MASK_SHIFT: u32 = 2
const RNG_IMR_AUTOCORR_ERR_INT_MASK_MASK: u32 = 0x00000002
const RNG_IMR_AUTOCORR_ERR_INT_MASK_SHIFT: u32 = 1
const RNG_IMR_EHR_VALID_INT_MASK_MASK: u32 = 0x00000001
const RNG_IMR_EHR_VALID_INT_MASK_SHIFT: u32 = 0

// RNG status register. If corresponding RNG_IMR bit is unmasked, an interrupt will be generated.
const RNG_ISR_OFFSET: u32 = 0x00000104
const RNG_ISR_VN_ERR_MASK: u32 = 0x00000008
const RNG_ISR_VN_ERR_SHIFT: u32 = 3
const RNG_ISR_CRNGT_ERR_MASK: u32 = 0x00000004
const RNG_ISR_CRNGT_ERR_SHIFT: u32 = 2
const RNG_ISR_AUTOCORR_ERR_MASK: u32 = 0x00000002
const RNG_ISR_AUTOCORR_ERR_SHIFT: u32 = 1
const RNG_ISR_EHR_VALID_MASK: u32 = 0x00000001
const RNG_ISR_EHR_VALID_SHIFT: u32 = 0

// Interrupt/status bit clear Register.
const RNG_ICR_OFFSET: u32 = 0x00000108
const RNG_ICR_VN_ERR_MASK: u32 = 0x00000008
const RNG_ICR_VN_ERR_SHIFT: u32 = 3
const RNG_ICR_CRNGT_ERR_MASK: u32 = 0x00000004
const RNG_ICR_CRNGT_ERR_SHIFT: u32 = 2
const RNG_ICR_AUTOCORR_ERR_MASK: u32 = 0x00000002
const RNG_ICR_AUTOCORR_ERR_SHIFT: u32 = 1
const RNG_ICR_EHR_VALID_MASK: u32 = 0x00000001
const RNG_ICR_EHR_VALID_SHIFT: u32 = 0

// Selecting the inverter-chain length.
const TRNG_CONFIG_OFFSET: u32 = 0x0000010c
const TRNG_CONFIG_RND_SRC_SEL_MASK: u32 = 0x00000003
const TRNG_CONFIG_RND_SRC_SEL_SHIFT: u32 = 0

// 192 bit collection indication.
const TRNG_VALID_OFFSET: u32 = 0x00000110
const TRNG_VALID_EHR_VALID_MASK: u32 = 0x00000001
const TRNG_VALID_EHR_VALID_SHIFT: u32 = 0

// RNG collected bits.
const EHR_DATA0_OFFSET: u32 = 0x00000114
const EHR_DATA0_EHR_DATA0_MASK: u32 = 0xffffffff
const EHR_DATA0_EHR_DATA0_SHIFT: u32 = 0

// RNG collected bits.
const EHR_DATA1_OFFSET: u32 = 0x00000118
const EHR_DATA1_EHR_DATA1_MASK: u32 = 0xffffffff
const EHR_DATA1_EHR_DATA1_SHIFT: u32 = 0

// RNG collected bits.
const EHR_DATA2_OFFSET: u32 = 0x0000011c
const EHR_DATA2_EHR_DATA2_MASK: u32 = 0xffffffff
const EHR_DATA2_EHR_DATA2_SHIFT: u32 = 0

// RNG collected bits.
const EHR_DATA3_OFFSET: u32 = 0x00000120
const EHR_DATA3_EHR_DATA3_MASK: u32 = 0xffffffff
const EHR_DATA3_EHR_DATA3_SHIFT: u32 = 0

// RNG collected bits.
const EHR_DATA4_OFFSET: u32 = 0x00000124
const EHR_DATA4_EHR_DATA4_MASK: u32 = 0xffffffff
const EHR_DATA4_EHR_DATA4_SHIFT: u32 = 0

// RNG collected bits.
const EHR_DATA5_OFFSET: u32 = 0x00000128
const EHR_DATA5_EHR_DATA5_MASK: u32 = 0xffffffff
const EHR_DATA5_EHR_DATA5_SHIFT: u32 = 0

// Enable signal for the random source.
const RND_SOURCE_ENABLE_OFFSET: u32 = 0x0000012c
const RND_SOURCE_ENABLE_RND_SRC_EN_MASK: u32 = 0x00000001
const RND_SOURCE_ENABLE_RND_SRC_EN_SHIFT: u32 = 0

// Counts clocks between sampling of random bit.
const SAMPLE_CNT1_OFFSET: u32 = 0x00000130
const SAMPLE_CNT1_SAMPLE_CNTR1_MASK: u32 = 0xffffffff
const SAMPLE_CNT1_SAMPLE_CNTR1_SHIFT: u32 = 0

// Statistics about autocorrelation test activations.
const AUTOCORR_STATISTIC_OFFSET: u32 = 0x00000134
const AUTOCORR_STATISTIC_AUTOCORR_FAILS_MASK: u32 = 0x003fc000
const AUTOCORR_STATISTIC_AUTOCORR_FAILS_SHIFT: u32 = 14
const AUTOCORR_STATISTIC_AUTOCORR_TRYS_MASK: u32 = 0x00003fff
const AUTOCORR_STATISTIC_AUTOCORR_TRYS_SHIFT: u32 = 0

// Debug register.
const TRNG_DEBUG_CONTROL_OFFSET: u32 = 0x00000138
const TRNG_DEBUG_CONTROL_AUTO_CORRELATE_BYPASS_MASK: u32 = 0x00000008
const TRNG_DEBUG_CONTROL_AUTO_CORRELATE_BYPASS_SHIFT: u32 = 3
const TRNG_DEBUG_CONTROL_TRNG_CRNGT_BYPASS_MASK: u32 = 0x00000004
const TRNG_DEBUG_CONTROL_TRNG_CRNGT_BYPASS_SHIFT: u32 = 2
const TRNG_DEBUG_CONTROL_VNC_BYPASS_MASK: u32 = 0x00000002
const TRNG_DEBUG_CONTROL_VNC_BYPASS_SHIFT: u32 = 1

// Generate internal SW reset within the RNG block.
const TRNG_SW_RESET_OFFSET: u32 = 0x00000140
const TRNG_SW_RESET_TRNG_SW_RESET_MASK: u32 = 0x00000001
const TRNG_SW_RESET_TRNG_SW_RESET_SHIFT: u32 = 0

// Enable the RNG debug mode
const RNG_DEBUG_EN_INPUT_OFFSET: u32 = 0x000001b4
const RNG_DEBUG_EN_INPUT_RNG_DEBUG_EN_MASK: u32 = 0x00000001
const RNG_DEBUG_EN_INPUT_RNG_DEBUG_EN_SHIFT: u32 = 0

// RNG Busy indication.
const TRNG_BUSY_OFFSET: u32 = 0x000001b8
const TRNG_BUSY_TRNG_BUSY_MASK: u32 = 0x00000001
const TRNG_BUSY_TRNG_BUSY_SHIFT: u32 = 0

// Reset the counter of collected bits in the RNG.
const RST_BITS_COUNTER_OFFSET: u32 = 0x000001bc
const RST_BITS_COUNTER_RST_BITS_COUNTER_MASK: u32 = 0x00000001
const RST_BITS_COUNTER_RST_BITS_COUNTER_SHIFT: u32 = 0

// Displays the version settings of the TRNG.
const RNG_VERSION_OFFSET: u32 = 0x000001c0
const RNG_VERSION_RNG_USE_5_SBOXES_MASK: u32 = 0x00000080
const RNG_VERSION_RNG_USE_5_SBOXES_SHIFT: u32 = 7
const RNG_VERSION_RESEEDING_EXISTS_MASK: u32 = 0x00000040
const RNG_VERSION_RESEEDING_EXISTS_SHIFT: u32 = 6
const RNG_VERSION_KAT_EXISTS_MASK: u32 = 0x00000020
const RNG_VERSION_KAT_EXISTS_SHIFT: u32 = 5
const RNG_VERSION_PRNG_EXISTS_MASK: u32 = 0x00000010
const RNG_VERSION_PRNG_EXISTS_SHIFT: u32 = 4
const RNG_VERSION_TRNG_TESTS_BYPASS_EN_MASK: u32 = 0x00000008
const RNG_VERSION_TRNG_TESTS_BYPASS_EN_SHIFT: u32 = 3
const RNG_VERSION_AUTOCORR_EXISTS_MASK: u32 = 0x00000004
const RNG_VERSION_AUTOCORR_EXISTS_SHIFT: u32 = 2
const RNG_VERSION_CRNGT_EXISTS_MASK: u32 = 0x00000002
const RNG_VERSION_CRNGT_EXISTS_SHIFT: u32 = 1
const RNG_VERSION_EHR_WIDTH_192_MASK: u32 = 0x00000001
const RNG_VERSION_EHR_WIDTH_192_SHIFT: u32 = 0

// Collected BIST results.
const RNG_BIST_CNTR_0_OFFSET: u32 = 0x000001e0
const RNG_BIST_CNTR_0_ROSC_CNTR_VAL_MASK: u32 = 0x003fffff
const RNG_BIST_CNTR_0_ROSC_CNTR_VAL_SHIFT: u32 = 0

// Collected BIST results.
const RNG_BIST_CNTR_1_OFFSET: u32 = 0x000001e4
const RNG_BIST_CNTR_1_ROSC_CNTR_VAL_MASK: u32 = 0x003fffff
const RNG_BIST_CNTR_1_ROSC_CNTR_VAL_SHIFT: u32 = 0

// Collected BIST results.
const RNG_BIST_CNTR_2_OFFSET: u32 = 0x000001e8
const RNG_BIST_CNTR_2_ROSC_CNTR_VAL_MASK: u32 = 0x003fffff
const RNG_BIST_CNTR_2_ROSC_CNTR_VAL_SHIFT: u32 = 0
