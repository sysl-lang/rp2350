// word-aligned.
const OTPBOOT_DST0_OFFSET: u32 = 0x00000180
const OTPBOOT_DST0_ECC_MASK: u32 = 0x00ff0000
const OTPBOOT_DST0_ECC_SHIFT: u32 = 16
