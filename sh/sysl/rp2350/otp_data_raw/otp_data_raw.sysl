// Predefined OTP data layout for RP2350

module sh.sysl.rp2350.otp_data_raw

// The peripheral's base address. Every offset below is from here.
const BASE: u32 = 0x40134000

// Bits 15:0 of public device ID. (ECC) The CHIPID0..3 rows contain a 64-bit random identifier for
// this chip, which can be read from the USB bootloader PICOBOOT interface or from the get_sys_info
// ROM API. The number of random bits makes the occurrence of twins exceedingly unlikely: for
// example, a fleet of a hundred million devices has a 99.97% probability of no twinned IDs. This
// is estimated to be lower than the occurrence of process errors in the assignment of sequential
// random IDs, and for practical purposes CHIPID may be treated as unique.
const CHIPID0_OFFSET: u32 = 0x00000000
const CHIPID0_ECC_MASK: u32 = 0x00ff0000
const CHIPID0_ECC_SHIFT: u32 = 16
const CHIPID0_CHIPID0_MASK: u32 = 0x0000ffff
const CHIPID0_CHIPID0_SHIFT: u32 = 0

// Bits 31:16 of public device ID (ECC)
const CHIPID1_OFFSET: u32 = 0x00000004
const CHIPID1_ECC_MASK: u32 = 0x00ff0000
const CHIPID1_ECC_SHIFT: u32 = 16
const CHIPID1_CHIPID1_MASK: u32 = 0x0000ffff
const CHIPID1_CHIPID1_SHIFT: u32 = 0

// Bits 47:32 of public device ID (ECC)
const CHIPID2_OFFSET: u32 = 0x00000008
const CHIPID2_ECC_MASK: u32 = 0x00ff0000
const CHIPID2_ECC_SHIFT: u32 = 16
const CHIPID2_CHIPID2_MASK: u32 = 0x0000ffff
const CHIPID2_CHIPID2_SHIFT: u32 = 0

// Bits 63:48 of public device ID (ECC)
const CHIPID3_OFFSET: u32 = 0x0000000c
const CHIPID3_ECC_MASK: u32 = 0x00ff0000
const CHIPID3_ECC_SHIFT: u32 = 16
const CHIPID3_CHIPID3_MASK: u32 = 0x0000ffff
const CHIPID3_CHIPID3_SHIFT: u32 = 0

// Bits 15:0 of private per-device random number (ECC) The RANDID0..7 rows form a 128-bit random
// number generated during device test. This ID is not exposed through the USB PICOBOOT GET_INFO
// command or the ROM `get_sys_info()` API. However note that the USB PICOBOOT OTP access point can
// read the entirety of page 0, so this value is not meaningfully private unless the USB PICOBOOT
// interface is disabled via the DISABLE_BOOTSEL_USB_PICOBOOT_IFC flag in BOOT_FLAGS0.
const RANDID0_OFFSET: u32 = 0x00000010
const RANDID0_ECC_MASK: u32 = 0x00ff0000
const RANDID0_ECC_SHIFT: u32 = 16
const RANDID0_RANDID0_MASK: u32 = 0x0000ffff
const RANDID0_RANDID0_SHIFT: u32 = 0

// Bits 31:16 of private per-device random number (ECC)
const RANDID1_OFFSET: u32 = 0x00000014
const RANDID1_ECC_MASK: u32 = 0x00ff0000
const RANDID1_ECC_SHIFT: u32 = 16
const RANDID1_RANDID1_MASK: u32 = 0x0000ffff
const RANDID1_RANDID1_SHIFT: u32 = 0

// Bits 47:32 of private per-device random number (ECC)
const RANDID2_OFFSET: u32 = 0x00000018
const RANDID2_ECC_MASK: u32 = 0x00ff0000
const RANDID2_ECC_SHIFT: u32 = 16
const RANDID2_RANDID2_MASK: u32 = 0x0000ffff
const RANDID2_RANDID2_SHIFT: u32 = 0

// Bits 63:48 of private per-device random number (ECC)
const RANDID3_OFFSET: u32 = 0x0000001c
const RANDID3_ECC_MASK: u32 = 0x00ff0000
const RANDID3_ECC_SHIFT: u32 = 16
const RANDID3_RANDID3_MASK: u32 = 0x0000ffff
const RANDID3_RANDID3_SHIFT: u32 = 0

// Bits 79:64 of private per-device random number (ECC)
const RANDID4_OFFSET: u32 = 0x00000020
const RANDID4_ECC_MASK: u32 = 0x00ff0000
const RANDID4_ECC_SHIFT: u32 = 16
const RANDID4_RANDID4_MASK: u32 = 0x0000ffff
const RANDID4_RANDID4_SHIFT: u32 = 0

// Bits 95:80 of private per-device random number (ECC)
const RANDID5_OFFSET: u32 = 0x00000024
const RANDID5_ECC_MASK: u32 = 0x00ff0000
const RANDID5_ECC_SHIFT: u32 = 16
const RANDID5_RANDID5_MASK: u32 = 0x0000ffff
const RANDID5_RANDID5_SHIFT: u32 = 0

// Bits 111:96 of private per-device random number (ECC)
const RANDID6_OFFSET: u32 = 0x00000028
const RANDID6_ECC_MASK: u32 = 0x00ff0000
const RANDID6_ECC_SHIFT: u32 = 16
const RANDID6_RANDID6_MASK: u32 = 0x0000ffff
const RANDID6_RANDID6_SHIFT: u32 = 0

// Bits 127:112 of private per-device random number (ECC)
const RANDID7_OFFSET: u32 = 0x0000002c
const RANDID7_ECC_MASK: u32 = 0x00ff0000
const RANDID7_ECC_SHIFT: u32 = 16
const RANDID7_RANDID7_MASK: u32 = 0x0000ffff
const RANDID7_RANDID7_SHIFT: u32 = 0

// Ring oscillator frequency in kHz, measured during manufacturing (ECC) This is measured at 1.1 V,
// at room temperature, with the ROSC configuration registers in their reset state.
const ROSC_CALIB_OFFSET: u32 = 0x00000040
const ROSC_CALIB_ECC_MASK: u32 = 0x00ff0000
const ROSC_CALIB_ECC_SHIFT: u32 = 16
const ROSC_CALIB_ROSC_CALIB_MASK: u32 = 0x0000ffff
const ROSC_CALIB_ROSC_CALIB_SHIFT: u32 = 0

// Low-power oscillator frequency in Hz, measured during manufacturing (ECC) This is measured at
// 1.1V, at room temperature, with the LPOSC trim register in its reset state.
const LPOSC_CALIB_OFFSET: u32 = 0x00000044
const LPOSC_CALIB_ECC_MASK: u32 = 0x00ff0000
const LPOSC_CALIB_ECC_SHIFT: u32 = 16
const LPOSC_CALIB_LPOSC_CALIB_MASK: u32 = 0x0000ffff
const LPOSC_CALIB_LPOSC_CALIB_SHIFT: u32 = 0

// The number of main user GPIOs (bank 0). Should read 48 in the QFN80 package, and 30 in the QFN60
// package. (ECC)
const NUM_GPIOS_OFFSET: u32 = 0x00000060
const NUM_GPIOS_ECC_MASK: u32 = 0x00ff0000
const NUM_GPIOS_ECC_SHIFT: u32 = 16
const NUM_GPIOS_NUM_GPIOS_MASK: u32 = 0x000000ff
const NUM_GPIOS_NUM_GPIOS_SHIFT: u32 = 0

// Lower 16 bits of CRC32 of OTP addresses 0x00 through 0x6b (polynomial 0x4c11db7, input
// reflected, output reflected, seed all-ones, final XOR all-ones) (ECC)
const INFO_CRC0_OFFSET: u32 = 0x000000d8
const INFO_CRC0_ECC_MASK: u32 = 0x00ff0000
const INFO_CRC0_ECC_SHIFT: u32 = 16
const INFO_CRC0_INFO_CRC0_MASK: u32 = 0x0000ffff
const INFO_CRC0_INFO_CRC0_SHIFT: u32 = 0

// Upper 16 bits of CRC32 of OTP addresses 0x00 through 0x6b (ECC)
const INFO_CRC1_OFFSET: u32 = 0x000000dc
const INFO_CRC1_ECC_MASK: u32 = 0x00ff0000
const INFO_CRC1_ECC_SHIFT: u32 = 16
const INFO_CRC1_INFO_CRC1_MASK: u32 = 0x0000ffff
const INFO_CRC1_INFO_CRC1_SHIFT: u32 = 0

// Page 0 critical boot flags (RBIT-8)
const CRIT0_OFFSET: u32 = 0x000000e0
const CRIT0_RISCV_DISABLE_MASK: u32 = 0x00000002
const CRIT0_RISCV_DISABLE_SHIFT: u32 = 1
const CRIT0_ARM_DISABLE_MASK: u32 = 0x00000001
const CRIT0_ARM_DISABLE_SHIFT: u32 = 0

// Redundant copy of CRIT0
const CRIT0_R1_OFFSET: u32 = 0x000000e4
const CRIT0_R1_CRIT0_R1_MASK: u32 = 0x00ffffff
const CRIT0_R1_CRIT0_R1_SHIFT: u32 = 0

// Redundant copy of CRIT0
const CRIT0_R2_OFFSET: u32 = 0x000000e8
const CRIT0_R2_CRIT0_R2_MASK: u32 = 0x00ffffff
const CRIT0_R2_CRIT0_R2_SHIFT: u32 = 0

// Redundant copy of CRIT0
const CRIT0_R3_OFFSET: u32 = 0x000000ec
const CRIT0_R3_CRIT0_R3_MASK: u32 = 0x00ffffff
const CRIT0_R3_CRIT0_R3_SHIFT: u32 = 0

// Redundant copy of CRIT0
const CRIT0_R4_OFFSET: u32 = 0x000000f0
const CRIT0_R4_CRIT0_R4_MASK: u32 = 0x00ffffff
const CRIT0_R4_CRIT0_R4_SHIFT: u32 = 0

// Redundant copy of CRIT0
