const CRIT1_R1_CRIT1_R1_SHIFT: u32 = 0

// Redundant copy of CRIT1
const CRIT1_R2_OFFSET: u32 = 0x00000108
const CRIT1_R2_CRIT1_R2_MASK: u32 = 0x00ffffff
const CRIT1_R2_CRIT1_R2_SHIFT: u32 = 0

