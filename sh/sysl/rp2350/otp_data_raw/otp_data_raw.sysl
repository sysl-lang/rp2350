const CRIT0_R7_CRIT0_R7_MASK: u32 = 0x00ffffff
const CRIT0_R7_CRIT0_R7_SHIFT: u32 = 0

// Page 1 critical boot flags (RBIT-8)
const CRIT1_OFFSET: u32 = 0x00000100
const CRIT1_GLITCH_DETECTOR_SENS_MASK: u32 = 0x00000060
const CRIT1_GLITCH_DETECTOR_SENS_SHIFT: u32 = 5
const CRIT1_GLITCH_DETECTOR_ENABLE_MASK: u32 = 0x00000010
const CRIT1_GLITCH_DETECTOR_ENABLE_SHIFT: u32 = 4
